# What the pipeline reads, and what 2-net reads to route this environment's
# hostnames. Readable by anything that can read the state bucket; no secrets.

{{if .FileStores -}}
output "file_stores" {
  description = "The file stores the site{{if .JobsFileStores}} and the job process{{end}} read and write: each variable and the gs:// URL of its bucket, as the processes receive them."
  value       = local.files_env
}

{{end -}}
{{if .MultiSite -}}
output "backend_service_ids" {
  description = "Backend service URI per site, in the form 2-net's hosts variable takes: projects/<project>/global/backendServices/<name>; empty for a pull-request stack."
  value       = { for site, backend in google_compute_backend_service.app : site => backend.id }
}
{{- else -}}
output "backend_service_id" {
  description = "Backend service URI in the form 2-net's hosts variable takes: projects/<project>/global/backendServices/<name>; null for a pull-request stack."
  value       = try(google_compute_backend_service.app[0].id, null)
}

output "backend_service_self_link" {
  description = "Full self link of the backend service the net project's URL map routes this environment's hostnames to (cross-project reference); null for a pull-request stack."
  value       = try(google_compute_backend_service.app[0].self_link, null)
}
{{- end}}

output "database" {
  description = "The Spanner database the site opens: its project, instance, and name; for a pull-request stack in shared mode, {{.Integration}}'s."
  value = {
    project  = local.instance.project
    instance = local.instance.name
    name     = local.database_name
  }
}

{{if .FirestoreDatabase -}}
output "firestore_database" {
  description = "The Firestore database the site{{if .MigrateReadsFirestore}}{{if .JobsReadsFirestore}},{{else}} and{{end}} the migrate command{{end}}{{if .JobsReadsFirestore}} and the job process{{end}} read and write, as {{.FirestoreDatabase.Name}} names it to them."
  value       = google_firestore_database.firestore.name
}

{{end -}}
output "hostnames" {
  description = "Hostnames this environment's site{{if .MultiSite}}s answer on, the first site's first and each site's canonical first (sites has each site's){{else}} answers on{{end}}; 2-net registers them with the load balancer and the certificate."
  value       = local.hostnames
}

output "identities" {
  description = "Runtime identities by process: app (the site){{if .Jobs}} and jobs (the job process){{end}}. The migration runs on the build worker as the deploy identity, 2-env's."
  value = {
    app = google_service_account.app.email
{{- if .Jobs}}
    jobs = google_service_account.jobs.email
{{- end}}
  }
}
{{- if .Jobs}}

output "jobs_job" {
  description = "The job process's Cloud Run job, which the application runs: its name, its region and the resource name the Cloud Run API takes."
  value = {
    name     = google_cloud_run_v2_job.jobs.name
    region   = google_cloud_run_v2_job.jobs.location
    resource = local.jobs_job
  }
}
{{- end}}

output "net_hosts" {
  description = "The entries to add to 2-net's hosts variable for this environment: each hostname{{if .Vanity}}, the vanity hostnames too,{{end}} mapped to the backend service URI, and each next hostname (<app>-<env>-next{{if .Vanity}}, on the apps domain alone{{end}}) to the next revision's backend. Empty for a pull-request stack, whose hostname the wildcard rule serves."
{{- if .MultiSite}}
  value = local.is_pr ? {} : merge([for site in local.sites : merge(
    { for host in local.site_hostnames[site] : host => google_compute_backend_service.app[site].id },
    { for host in local.site_next_hostnames[site] : host => google_compute_backend_service.next[site].id },
  )]...)
{{- else}}
  value = local.is_pr ? {} : merge(
    { for host in local.hostnames : host => google_compute_backend_service.app[0].id },
    { for host in local.next_hostnames : host => google_compute_backend_service.next[0].id },
  )
{{- end}}
}

output "registry" {
  description = "Image repository the pipeline pushes to, as <hostname>/<project>/<repository>; null until 2-shr registers the application."
  value       = local.registry
}

output "revision_templates" {
  description = "What each service's revision runs with, by service name, and the job process's job{{if not .Jobs}} (none){{end}}: identity, scaling, variables and secret mounts as this stack evaluates them. The pipeline builds every revision and job from it and the release's image (bedrock deploy service, deploy jobs), read off the stack it applied, or off the plan of the release's stack in a rollback run, so a release runs under its own release's configuration, forward or back, and no apply starts a revision."
  value = {
    services = {
      for key, svc in google_cloud_run_v2_service.app : svc.name => {
        serviceAccount = google_service_account.app.email
        maxInstances   = {{if .MaxInstancesMap}}local.max_instances{{else}}null{{end}}
        timeout        = "300s"
        port           = {{.Port.Default}}
        http2          = {{if .MultiSite}}local.site_settings[local.services[key].site].h2c{{else}}{{(index .Sites 0).H2C}}{{end}}
        args           = {{if .MultiSite}}[local.site_settings[local.services[key].site].binary]{{else}}[]{{end}}
        cpu            = "1"
        memory         = "512Mi"
        labels         = local.labels
        env            = {{if .MultiSite}}merge(local.service_env, local.site_env[local.services[key].site]){{else}}local.service_env{{end}}
        secrets        = { for name, s in local.mounted_secrets : name => { secret = local.secret_ids[name], version = tostring(s.version) } }
      }
    }
{{- if .Jobs}}
    job = {
      serviceAccount = google_service_account.jobs.email
      timeout        = var.jobs_timeout
      maxRetries     = var.jobs_retries
      cpu            = var.jobs_resources.cpu
      memory         = var.jobs_resources.memory
      command        = ["/jobs"]
      labels         = local.labels
      env            = local.jobs_env
      secrets        = {{if .JobsReadsData}}{ for name, s in local.jobs_mounted_secrets : name => { secret = local.secret_ids[name], version = tostring(s.version) } }{{else}}{}{{end}}
    }
{{- else}}
    job = null
{{- end}}
  }
}

output "secrets" {
  description = "Secret container ID by the environment variable it feeds, and the version this environment runs (null when not pinned yet)."
  value = {
    for key, s in local.secrets : key => {
      secret_id = local.secret_ids[key]
      version   = lookup(local.secret_versions, key, null)
    }
  }
}

output "services" {
  description = "Cloud Run service by {{if .MultiSite}}<site>-<region code>{{else}}region code{{end}}: name, region, and the run.app URI (not the public one; that is the hostname through the load balancer)."
  value = {
    for code, svc in google_cloud_run_v2_service.app : code => {
      name   = svc.name
      region = svc.location
      uri    = svc.uri
    }
  }
}
{{- if .MultiSite}}

output "sites" {
  description = "Each site: its hostnames in this environment (the canonical first), the next revision's, its backend services (null for a pull-request stack) and its services by region code."
  value = {
    for site in local.sites : site => {
      hostnames               = local.site_hostnames[site]
      next_hostnames          = local.site_next_hostnames[site]
      backend_service_id      = try(google_compute_backend_service.app[site].id, null)
      next_backend_service_id = try(google_compute_backend_service.next[site].id, null)
      services = {
        for key, svc in google_cloud_run_v2_service.app : local.services[key].code => {
          name   = svc.name
          region = svc.location
          uri    = svc.uri
        } if local.services[key].site == site
      }
    }
  }
}
{{- end}}

{{range .Methods -}}
output "{{.Var "REDIRECT_URL"}}" {
  description = "Redirect URI to register on {{.Label}} with {{.Provider}} ({{(.Variable "RedirectURL").Name}})."
  value       = local.{{.Var "REDIRECT_URL"}}
}

{{if .Microsoft -}}
output "{{.Var "LOGOUT_URL"}}" {
  description = "Front-channel logout URL to register on {{.Label}} with Microsoft."
  value       = local.{{.Var "LOGOUT_URL"}}
}

{{end -}}
{{end -}}
{{if .TasksQueue -}}
output "tasks_queue" {
  description = "The task queue the site{{if .JobsReadsTasks}} and the job process{{end}} enqueue on, as {{.TasksQueue.Name}} names it to them; a pull-request stack's is {{.Integration}}'s."
  value       = local.tasks_queue
}

{{end -}}
output "stack_id" {
  description = "The stack's id (initialize.tf): the suffix of the names Google holds after a delete, and the prefix of this stack's deployment records in the records bucket, <app>/<env>/<id>/."
  value       = random_id.stack.hex
}

output "substitutions" {
  description = "The substitutions the version trigger passes to cloudbuild.yaml (_PR_NUMBER empty: no pull request); a pull-request build reads its own stack's copy from the state for the facts the deploy steps need. The pull-request trigger passes the same without _PR_NUMBER, which its event supplies."
  value       = merge(local.substitutions, local.custom_substitutions, { _PR_NUMBER = "" })
}

output "triggers" {
  description = "Cloud Build trigger IDs: version in every environment, pr in {{.Integration}}; null until 2-env holds the GitHub connection."
  value = {
    version = try(google_cloudbuild_trigger.version[0].id, null)
    pr      = try(google_cloudbuild_trigger.pr[0].id, null)
  }
}
