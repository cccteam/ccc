# {{.App}}'s operations: a restore of an environment to a release, started from GitHub and run by
# the environment's pipeline. Rendered by bedrock and owned by it (bedrock render rewrites this
# file, bedrock check compares it). The job runs in the GitHub Environment named after the target
# environment, which deploys from {{.P.DefaultBranch}} alone (declared by the organization's 1-org
# layer), exchanges its GitHub token for the environment's operations identity through Workload
# Identity Federation (no key exists anywhere; the environment's provider trusts tokens of this
# repository, this workflow file and that Environment alone), and runs the environment's version
# trigger for the release with the restore instruction. Everything that changes the environment
# happens inside that run, as the deploy identity, as for any release: the application goes into
# maintenance, the database is replaced (an empty one, which the migrations then fill, and the seed
# where the placement's seed list names the environment, or production's most recent backup), the
# release's jobs are created, the migrations run, the revision deploys, traffic moves, and the
# record names the requester. The identity here starts the trigger and reads how the build went, and
# nothing else. Production is never restored by a run. Started by bedrock restore <env> <release>,
# or by the Run workflow button; a release waits for its approval in Cloud Build as any release
# does.
name: operations

on:
  workflow_dispatch:
    inputs:
      environment:
        description: The environment to restore ({{.OperationsProse}})
        type: choice
        required: true
        options:
{{- range .Operations}}
          - {{.Env}}
{{- end}}
      release:
        description: The release to restore the environment to (v<major>.<minor>.<patch>, one that exists)
        type: string
        required: true

permissions: {}

jobs:
  restore:
    name: restore ${{"{{"}} inputs.environment {{"}}"}} to ${{"{{"}} inputs.release {{"}}"}}
    runs-on: ubuntu-latest
    environment: ${{"{{"}} inputs.environment {{"}}"}}
    permissions:
      id-token: write
    env:
      ENVIRONMENT: ${{"{{"}} inputs.environment {{"}}"}}
      RELEASE: ${{"{{"}} inputs.release {{"}}"}}
      REQUESTER: ${{"{{"}} github.actor {{"}}"}}
      REGION: {{.PrimaryRegion}}
{{- range .Operations}}
{{- if .Wired}}
      PROJECT_{{.Env}}: {{.Project}}
      PROVIDER_{{.Env}}: {{.Provider}}
      IDENTITY_{{.Env}}: {{.Identity}}
      TRIGGER_{{.Env}}: {{.Trigger}}
      RESTORE_{{.Env}}: {{.Restore}}
{{- end}}
{{- end}}
    steps:
      # The environment's values, from the placement's projects: an environment the placement
      # records no project for is not wired, and the run stops before touching anything.
      - name: The environment's project, identity, trigger and restore
        id: target
        run: |
          case "$RELEASE" in
            v[0-9]*.[0-9]*.[0-9]*) ;;
            *) echo "::error::$RELEASE is not a release tag (v<major>.<minor>.<patch>)"; exit 1 ;;
          esac
          project=$(eval "printf '%s' \"\${PROJECT_$ENVIRONMENT:-}\"")
          if [ -z "$project" ]; then
            echo "::error::$ENVIRONMENT is not wired for operations: record its project (projects.$ENVIRONMENT, the id and the number bedrock org register prints) in infrastructure/placement.json and render again"
            exit 1
          fi
          for name in project provider identity trigger restore; do
            upper=$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')
            printf '%s=%s\n' "$name" "$(eval "printf '%s' \"\${${upper}_$ENVIRONMENT}\"")" >> "$GITHUB_OUTPUT"
          done
      - uses: google-github-actions/auth@{{.AuthAction}}
        with:
          workload_identity_provider: ${{"{{"}} steps.target.outputs.provider {{"}}"}}
          service_account: ${{"{{"}} steps.target.outputs.identity {{"}}"}}
      - uses: google-github-actions/setup-gcloud@{{.GcloudAction}}
      # The version trigger's build with the restore instruction, waited for to its end: a
      # release in an environment that waits for an approval in Cloud Build waits here too.
      - name: Run the version trigger with the restore instruction
        env:
          PROJECT: ${{"{{"}} steps.target.outputs.project {{"}}"}}
          TRIGGER: ${{"{{"}} steps.target.outputs.trigger {{"}}"}}
          RESTORE: ${{"{{"}} steps.target.outputs.restore {{"}}"}}
        run: |
          build=$(gcloud builds triggers run "$TRIGGER" --tag "$RELEASE" --region "$REGION" --project "$PROJECT" \
            --substitutions "_RESTORE=$RESTORE,_REQUESTER=$REQUESTER" --format='value(metadata.build.id)')
          echo "Build $build in $ENVIRONMENT restores it to $RELEASE ($RESTORE), asked for by $REQUESTER."
          echo "https://console.cloud.google.com/cloud-build/builds;region=$REGION/$build?project=$PROJECT"
          while :; do
            status=$(gcloud builds describe "$build" --region "$REGION" --project "$PROJECT" --format='value(status)')
            case "$status" in
              SUCCESS) echo "Build $build succeeded: $ENVIRONMENT runs $RELEASE on its restored database."; exit 0 ;;
              FAILURE|CANCELLED|TIMEOUT|INTERNAL_ERROR|EXPIRED) echo "::error::Build $build ended $status; its log says why."; exit 1 ;;
              PENDING) echo "Build $build is pending: an approval in Cloud Build may be waiting." ;;
            esac
            sleep 30
          done
