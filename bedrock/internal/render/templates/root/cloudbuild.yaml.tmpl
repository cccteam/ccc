# {{.App}}'s deploy pipeline: Cloud Build steps, in the sequence CCC's deployments use, that take one
# commit into one environment. Rendered by bedrock from its pipeline template and owned by it:
# bedrock render rewrites this file and bedrock check compares it with the code, so a change
# belongs in bedrock, never here.
#
#   ResolveDeploymentTarget   what is deployed, where, and whether this build may deploy it
#   GuardMigrations           the migrations are one contiguous sequence, unchanged once committed, or the build stops
#   Hook*                     the application's own scripts at four stages, when it commits them
#   CheckRelease              a release already in the registry is reused (same commit) or refused
#   BuildImage                one image per environment, built fresh from the commit, pushed
#   RunMigrations             the migrate command as a Cloud Run job, run to completion
#   DeployServiceNoTraffic    a new revision in every region, receiving no traffic yet
#   ShiftTraffic              every region to 100 percent on its new revision
#   WriteDeploymentRecord     the record of what is now running, in the records bucket (bedrock deploy record, from the pinned bedrock image)
#
# The revision template (variables, secret mounts, identity, scaling) belongs to the
# application's infrastructure layer (3-app/<app> in the infrastructure repository); a
# deploy changes the image and stamps its labels, nothing else, so a later apply of that
# layer and a deploy never fight over the same fields.
#
# Two kinds of trigger run it (README.md, "Deploying"):
#   - a version trigger per environment, on a tag push: the tagged commit must be on the
#     default branch, the migrate job runs, traffic shifts.
#   - the pull-request trigger for tst, started by a "/gcbrun" comment: the revision is
#     deployed under the tag pr<N> with no traffic, and the migrate job runs only when the
#     comment says "reload-db".
#
# Every shell variable is written $$NAME: Cloud Build reads $NAME and ${NAME} as its own
# substitutions and hands the shell one dollar sign for $$. The substitutions are listed
# at the end of this file and in README.md.

steps:
  # What is deployed and where: the trigger's kind, the environment, the tag or the pull
  # request's comment. Whether a tag may deploy is the next step's question. Everything
  # the later steps share is written to /workspace/environment.sh, which each sources. This
  # step also refuses, before the image build, a run that does not name what it updates.
  - id: ResolveDeploymentTarget
    waitFor: ["-"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 300s
    args:
      - -c
      - |
        set -euo pipefail

        # A build is a tag build or a pull-request build, never neither.
        if [ -z "${TAG_NAME}" ] && [ -z "${_PR_NUMBER}" ]; then
          echo "Error: neither TAG_NAME nor _PR_NUMBER is set; a run needs one of them."
          exit 1
        fi

        case "${_ENV}" in
          tst|stg|prd) ;;
          *) echo "Error: _ENV must be tst, stg, or prd (got '${_ENV}')."; exit 1 ;;
        esac

        # What this build updates, named by the application layer's substitutions output:
        # the services (region=name, comma-separated) and the migrate job (region=name).
        if [ -z "${_SERVICES}" ] || [ -z "${_MIGRATE_JOB}" ]; then
          echo "Error: _SERVICES and _MIGRATE_JOB name the Cloud Run services and the migrate job this build updates; both are empty."
          exit 1
        fi

        # jq parses the GitHub API's answers.
        apt-get -qq update && apt-get -qq install -y jq

        # A GitHub token for the repository, minted from the Cloud Build connection the
        # trigger reads the repository through. Before the environment holds a
        # connection (3-app passes CONNECTION_NOT_AUTHORIZED_IN_2-ENV), only a build
        # submitted by hand reaches here, and the GitHub checks below are skipped
        # with a notice; a triggered build always has a connection.
        if [[ "${_REPO_CONNECTION_NAME}" == CONNECTION_NOT_AUTHORIZED* ]]; then
          echo "Notice: no Cloud Build connection in ${_ENV} yet; the branch check and the pull-request comment are skipped (hand-submitted build)."
          GITHUB_TOKEN=''
        else
          # A failed mint says why (the status and the API's message) instead of
          # exiting silently under curl -f, as the first triggered build did. The
          # deploy identity needs Read Token Accessor on the connection for it.
          MINT=$(curl -s -X POST -H "Content-Type: application/json" \
            -H "Authorization: Bearer $(gcloud auth print-access-token)" \
            -w '\n%{http_code}' \
            "https://cloudbuild.googleapis.com/v2/projects/${PROJECT_ID}/locations/${LOCATION}/connections/${_REPO_CONNECTION_NAME}/repositories/${_REPO_NAME}:accessReadToken")
          MINT_STATUS=$${MINT##*$$'\n'}
          MINT_BODY=$${MINT%$$'\n'*}
          if [[ "$${MINT_STATUS}" != "200" ]]; then
            echo "Error: could not mint a GitHub token from connection ${_REPO_CONNECTION_NAME} (HTTP $${MINT_STATUS}): $$(echo "$${MINT_BODY}" | jq -r '.error.message // .' 2>/dev/null)"
            exit 1
          fi
          GITHUB_TOKEN=$(echo "$${MINT_BODY}" | jq -r '.token')
        fi

        RUN_MIGRATIONS='true'
        SHIFT_TRAFFIC='true'
        REVISION_TAG=''
        # Pull-request options (/gcbrun shared-db: the site runs against tst's database
        # and the migrate job does not run; /gcbrun reload-db: the pull request's own
        # database is recreated; /gcbrun down: the pull request's environment is
        # destroyed and nothing deploys).
        SHARED_DB=''
        RELOAD_DB=''
        DOWN=''

        # The branch check and the comment read address the repository by its full name,
        # a trigger built-in; a hand-submitted build passes it (the hand submission in the
        # stack's README), or the compare answers 404 for an empty name.
        if [ -n "$${GITHUB_TOKEN:-}" ] && [ -z "${REPO_FULL_NAME}" ]; then
          echo "Error: REPO_FULL_NAME is not set; a hand-submitted build passes it as <organization>/<repository>."
          exit 1
        fi
        if [ -n "${TAG_NAME}" ]; then
          echo "Triggered by tag ${TAG_NAME}"
          VERSION="${TAG_NAME}"
          RELEASE="${TAG_NAME}"

          # The release checks (a GitHub Release by an accepted actor; on the default
          # branch or at the tip of its hotfix branch; the record gate) are the next
          # step's, ValidateRelease, which sources what this one writes.
        else
          echo "Triggered by pull request ${_PR_NUMBER}"
          if [[ "${_ENV}" != "tst" ]]; then
            echo "Error: a pull-request build deploys only to tst (this trigger's _ENV is ${_ENV})."
            exit 1
          fi
          VERSION="pr${_PR_NUMBER}@${SHORT_SHA}"
          # The registry's tags are immutable and the records bucket refuses overwrites,
          # so a pull request's release carries the commit: each build of the pull request
          # is its own image tag and record, while the revision tag stays pr<N>.
          RELEASE="pr${_PR_NUMBER}-${SHORT_SHA}"
          # A pull request has an environment of its own (its stack, applied by the
          # ApplyPullRequestStack step): the service is its own, so the revision takes
          # traffic, and the database is its own, so the migrations run every build.
          REVISION_TAG=''
          SHIFT_TRAFFIC='true'
          RUN_MIGRATIONS='true'

          if [ -z "$${GITHUB_TOKEN}" ]; then
            echo "Error: a pull-request build needs the Cloud Build connection to read its /gcbrun comment."
            exit 1
          fi

          # The comment that started the build carries its options. Only the last few
          # comments are fetched: the total decides the page size and the page.
          TOTAL_COMMENTS=$(curl -s -f -H "Authorization: Bearer $${GITHUB_TOKEN}" -H "Accept: application/vnd.github.v3+json" \
            "https://api.github.com/repos/${REPO_FULL_NAME}/issues/${_PR_NUMBER}" | jq '.comments')
          if [ "$${TOTAL_COMMENTS}" -le $((5 * 2)) ]; then
            PAGE_SIZE=$${TOTAL_COMMENTS}
            PAGE=1
          else
            PAGES_TO_SKIP=$(( (TOTAL_COMMENTS - 5 - 1) / 100 + 1 ))
            PAGE_SIZE=$(( (TOTAL_COMMENTS - 5) / PAGES_TO_SKIP ))
            PAGE=$(( PAGES_TO_SKIP + 1 ))
          fi
          echo "TOTAL_COMMENTS=$${TOTAL_COMMENTS}, PAGE_SIZE=$${PAGE_SIZE}, PAGE=$${PAGE}"

          curl -s -f -H "Authorization: Bearer $${GITHUB_TOKEN}" -H "Accept: application/vnd.github.v3+json" \
            "https://api.github.com/repos/${REPO_FULL_NAME}/issues/${_PR_NUMBER}/comments?per_page=$${PAGE_SIZE}&page=$${PAGE}" \
            > /workspace/comments.json

          # The latest comment that starts with /gcbrun is the instruction.
          LATEST=$(jq -c '.[] | select(.body | startswith("/gcbrun")) | [.id, .body]' /workspace/comments.json | tail -1)
          if [[ -z "$${LATEST}" ]]; then
            echo "Error: no /gcbrun comment found on pull request ${_PR_NUMBER}."
            exit 1
          fi
          COMMENT_BODY=$(echo "$${LATEST}" | jq -r '.[1]')
          echo "COMMENT_BODY=$${COMMENT_BODY}"

          # The words after /gcbrun are its options; anything else is a typo and stops
          # the build rather than being ignored.
          read -r -a COMMENT_WORDS <<< "$${COMMENT_BODY}"
          for ((i=1; i<$${#COMMENT_WORDS[@]}; i++)); do
            case "$${COMMENT_WORDS[i]}" in
              shared-db) SHARED_DB='true' ;;
              reload-db) RELOAD_DB='true' ;;
              down) DOWN='true' ;;
              *) echo "Error: unknown /gcbrun option '$${COMMENT_WORDS[i]}' (the options are shared-db, reload-db and down)."; exit 1 ;;
            esac
          done
          if [ "$${SHARED_DB}" = "true" ] && [ "$${RELOAD_DB}" = "true" ]; then
            echo "Error: /gcbrun shared-db with reload-db: reload-db recreates the pull request's own database, and in shared mode there is none."
            exit 1
          fi
          if [ "$${SHARED_DB}" = "true" ]; then
            # tst's schema is tst's: the migrate job never runs against the shared database
            # (the guard refuses shared-db when the migrations changed at all).
            RUN_MIGRATIONS='false'
          fi
        fi

        IMAGE="${_REGISTRY}/${_APP}"
        # One registry serves every environment and each environment is a fresh build of
        # the tag (nothing is promoted), so the image tags carry the environment:
        # <release>-<env> and <commit>-<env>. The release check compares those.
        IMAGE_TAG="$${RELEASE}-${_ENV}"
        COMMIT_TAG="${COMMIT_SHA}-${_ENV}"
        echo "IMAGE=$${IMAGE} IMAGE_TAG=$${IMAGE_TAG} VERSION=$${VERSION} RELEASE=$${RELEASE}"
        echo "RUN_MIGRATIONS=$${RUN_MIGRATIONS} SHIFT_TRAFFIC=$${SHIFT_TRAFFIC} REVISION_TAG=$${REVISION_TAG}"

        # The services and the migrate job this build updates: the environment's, from the
        # trigger; a pull-request build replaces them with its own stack's (ApplyPullRequestStack).
        cat << EOF > /workspace/environment.sh
        export GITHUB_TOKEN="$${GITHUB_TOKEN}"
        export SERVICES="${_SERVICES}"
        export MIGRATE_JOB="${_MIGRATE_JOB}"
        export SHARED_DB="$${SHARED_DB}"
        export RELOAD_DB="$${RELOAD_DB}"
        export DOWN="$${DOWN}"
        export SKIP_DEPLOY=""
        export IMAGE="$${IMAGE}"
        export IMAGE_TAG="$${IMAGE_TAG}"
        export COMMIT_TAG="$${COMMIT_TAG}"
        export VERSION="$${VERSION}"
        export RELEASE="$${RELEASE}"
        export REVISION_TAG="$${REVISION_TAG}"
        export RUN_MIGRATIONS="$${RUN_MIGRATIONS}"
        export SHIFT_TRAFFIC="$${SHIFT_TRAFFIC}"
        EOF

        # Every substitution of this build, exported for the hooks: the ones this file
        # knows and the ones the placement declares (var.substitutions in the stack, per
        # environment). The build reads itself through the API, so nothing is rendered per
        # name. The declared ones also reach the image build as build arguments, one
        # --build-arg _NAME=value each in /workspace/build-args.sh (a bash array, kept out
        # of environment.sh, which the OpenTofu steps read with a plain sh), for the
        # Dockerfile's ARG _NAME. Known and not declared: the stack's substitutions, the
        # trigger's own (_PR_NUMBER and, on a pull request, _BASE_BRANCH, _HEAD_BRANCH,
        # _HEAD_REPO_URL) and this file's default (_DEFAULT_BRANCH).
        gcloud builds describe "${BUILD_ID}" --project "${_PROJECT}" --region "${LOCATION}" --format=json > /workspace/build.json
        jq -r '.substitutions // {} | to_entries[] | select(.key | startswith("_")) | "export \(.key)=\(.value | @sh)"' /workspace/build.json >> /workspace/environment.sh
        echo 'BUILD_ARGS=()' > /workspace/build-args.sh
        KNOWN=" {{.SubstitutionNames}} _PR_NUMBER _BASE_BRANCH _HEAD_BRANCH _HEAD_REPO_URL _DEFAULT_BRANCH "
        jq -r --arg known "$${KNOWN}" \
          '.substitutions // {} | to_entries[] | select(.key | startswith("_")) | .key as $$k | select(($$known | contains(" " + $$k + " ")) | not) | "BUILD_ARGS+=(--build-arg \(.key + "=" + .value | @sh))"' \
          /workspace/build.json >> /workspace/build-args.sh
        DECLARED=$(jq -r --arg known "$${KNOWN}" '[.substitutions // {} | to_entries[] | select(.key | startswith("_")) | .key as $$k | select(($$known | contains(" " + $$k + " ")) | not) | $$k] | join(", ")' /workspace/build.json)
        echo "Declared substitutions for the hooks and the image build: $${DECLARED:-none}"

  # The deployer GitHub App's token, for a pull-request build that has an app to
  # talk back with (a deployment, comments): a JWT signed with the app's private key,
  # read from the pinned secret version 2-env names, exchanged for an installation
  # token good for an hour. The key touches the workspace for the signature only.
  - id: MintDeployerToken
    waitFor: ["ResolveDeploymentTarget"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 120s
    args:
      - -c
      - |
        set -euo pipefail
        if [ -z "${_PR_NUMBER}" ] || [ -z "${_DEPLOYER_APP_ID}" ] || [ -z "${_DEPLOYER_KEY_SECRET}" ]; then
          echo "No talk-back: not a pull-request build, or no deployer app in ${_ENV} yet."
          exit 0
        fi
        apt-get -qq update && apt-get -qq install -y jq
        gcloud secrets versions access "${_DEPLOYER_KEY_SECRET}" > /workspace/deployer.pem
        b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
        NOW=$(date +%s)
        HEADER=$(printf '{"alg":"RS256","typ":"JWT"}' | b64)
        CLAIMS=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((NOW - 60)) $((NOW + 540)) "${_DEPLOYER_APP_ID}" | b64)
        SIGNATURE=$(printf '%s.%s' "$${HEADER}" "$${CLAIMS}" | openssl dgst -sha256 -sign /workspace/deployer.pem | b64)
        rm -f /workspace/deployer.pem
        JWT="$${HEADER}.$${CLAIMS}.$${SIGNATURE}"
        INSTALLATION=$(curl -s -f -H "Authorization: Bearer $${JWT}" -H "Accept: application/vnd.github+json" \
          "https://api.github.com/repos/${REPO_FULL_NAME}/installation" | jq -r '.id')
        TOKEN=$(curl -s -f -X POST -H "Authorization: Bearer $${JWT}" -H "Accept: application/vnd.github+json" \
          "https://api.github.com/app/installations/$${INSTALLATION}/access_tokens" | jq -r '.token')
        if [ -z "$${TOKEN}" ] || [ "$${TOKEN}" = "null" ]; then
          echo "Error: could not mint an installation token for the deployer app ${_DEPLOYER_APP_ID} on ${REPO_FULL_NAME}."
          exit 1
        fi
        echo "export DEPLOYER_TOKEN=\"$${TOKEN}\"" >> /workspace/environment.sh
        echo "Deployer app ${_DEPLOYER_APP_ID}: token minted for installation $${INSTALLATION}."

  # Whether this release may deploy here, for a tag build (a pull-request build has no
  # release to validate). Three checks: the tag belongs to a GitHub Release cut by an
  # accepted release actor; the tagged commit is on the default branch or at the tip of
  # its hotfix branch; and the previous environment holds a live deployment record of
  # the release (the record gate). Cloud Build caps a step's script at 10,000
  # characters, which is why this is not part of ResolveDeploymentTarget.
  - id: ValidateRelease
    waitFor: ["MintDeployerToken"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 300s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi

        if [ -z "${TAG_NAME}" ]; then
          echo "Pull-request build: no release to validate."
          exit 0
        fi

        # jq parses the GitHub API's answers and the deployment records.
        apt-get -qq update && apt-get -qq install -y jq

          # Two checks stand between a tag and a build, both through the GitHub API.
          # First, the tag belongs to a GitHub Release cut by an accepted release actor
          # (_RELEASE_ACTORS, comma-separated logins: the release app as <slug>[bot]),
          # which is how release-please, and nothing else, makes a release. Second, the
          # tagged commit is on the default branch ("identical": the branch is at the
          # commit; "ahead": it has moved past it), or it is a hotfix: the tip of the
          # line's branch hotfix/<major>.<minor>.x, whose base on the default branch
          # carries a release tag of the same line.
          if [ -n "$${GITHUB_TOKEN}" ]; then
            API="https://api.github.com/repos/${REPO_FULL_NAME}"
            AUTH=(-s -H "Authorization: Bearer $${GITHUB_TOKEN}" -H "Accept: application/vnd.github+json")

            RELEASE_JSON=$(curl "$${AUTH[@]}" -w '\n%{http_code}' "$${API}/releases/tags/${TAG_NAME}")
            RELEASE_STATUS=$${RELEASE_JSON##*$$'\n'}
            RELEASE_BODY=$${RELEASE_JSON%$$'\n'*}
            if [[ "$${RELEASE_STATUS}" != "200" ]]; then
              echo "Build REJECTED: tag ${TAG_NAME} has no GitHub Release (HTTP $${RELEASE_STATUS}); a release is cut by release-please as the release app, never by a tag alone."
              exit 1
            fi
            RELEASE_AUTHOR=$(echo "$${RELEASE_BODY}" | jq -r '.author.login')
            if [[ ",${_RELEASE_ACTORS}," != *",$${RELEASE_AUTHOR},"* ]]; then
              echo "Build REJECTED: the GitHub Release for ${TAG_NAME} was made by $${RELEASE_AUTHOR}, not by an accepted release actor (${_RELEASE_ACTORS})."
              exit 1
            fi
            echo "Release ${TAG_NAME} validated: cut by $${RELEASE_AUTHOR}"

            COMPARE_STATUS=$(curl "$${AUTH[@]}" "$${API}/compare/${COMMIT_SHA}...${_DEFAULT_BRANCH}" | jq -r '.status')
            if [[ "$${COMPARE_STATUS}" == "ahead" || "$${COMPARE_STATUS}" == "identical" ]]; then
              echo "Tag ${TAG_NAME} validated: its commit is on ${_DEFAULT_BRANCH}"
            else
              LINE=$(echo "${TAG_NAME}" | sed -nE 's/^v([0-9]+)\.([0-9]+)\.[0-9]+$/\1.\2/p')
              if [ -z "$${LINE}" ]; then
                echo "Build REJECTED: tag ${TAG_NAME} is not on ${_DEFAULT_BRANCH} (compare status: $${COMPARE_STATUS}) and is not a v<major>.<minor>.<patch> tag a hotfix line could carry."
                exit 1
              fi
              HOTFIX_BRANCH="hotfix/$${LINE}.x"
              TIP=$(curl "$${AUTH[@]}" "$${API}/git/ref/heads/$${HOTFIX_BRANCH}" | jq -r '.object.sha // empty')
              if [ -z "$${TIP}" ]; then
                echo "Build REJECTED: tag ${TAG_NAME} is not on ${_DEFAULT_BRANCH} (compare status: $${COMPARE_STATUS}) and there is no branch $${HOTFIX_BRANCH} it could be a hotfix of."
                exit 1
              fi
              if [[ "$${TIP}" != "${COMMIT_SHA}" ]]; then
                echo "Build REJECTED: tag ${TAG_NAME} (commit ${COMMIT_SHA}) is not at the tip of $${HOTFIX_BRANCH} ($${TIP}); a hotfix release is the branch's tip."
                exit 1
              fi
              BASE=$(curl "$${AUTH[@]}" "$${API}/compare/${_DEFAULT_BRANCH}...${COMMIT_SHA}" | jq -r '.merge_base_commit.sha // empty')
              BASE_TAG=$(curl "$${AUTH[@]}" "$${API}/tags?per_page=100" | jq -r --arg base "$${BASE}" --arg prefix "v$${LINE}." '[.[] | select(.commit.sha == $$base and (.name | startswith($$prefix)))] | .[0].name // empty')
              if [ -z "$${BASE_TAG}" ]; then
                echo "Build REJECTED: $${HOTFIX_BRANCH} branches from $${BASE} on ${_DEFAULT_BRANCH}, which carries no v$${LINE}.* release tag; a hotfix line starts at a release."
                exit 1
              fi
              echo "Tag ${TAG_NAME} validated as a hotfix: the tip of $${HOTFIX_BRANCH}, branched from release $${BASE_TAG} on ${_DEFAULT_BRANCH}"
            fi
          fi

          # The record gate: this environment follows the previous one in the promotion
          # order (_PREVIOUS_ENV, empty in the first). A release runs here only after the
          # previous environment holds a live deployment record of it, which its
          # WriteDeploymentRecord writes once traffic has shifted there. The deploy
          # identity reads that environment's records bucket by a grant 2-env makes there.
          if [ -n "${_PREVIOUS_ENV}" ]; then
            RECORDS_PREFIX="gs://${_PREVIOUS_RECORDS_BUCKET}/${_APP}/${_PREVIOUS_ENV}/${TAG_NAME}/"
            RECORDS=$(gcloud storage ls "$${RECORDS_PREFIX}" 2>/dev/null || true)
            if [ -z "$${RECORDS}" ]; then
              echo "Build REJECTED: release ${TAG_NAME} has no deployment record in ${_PREVIOUS_ENV} (nothing under $${RECORDS_PREFIX}); a release reaches ${_ENV} after it is live in ${_PREVIOUS_ENV}."
              exit 1
            fi
            LIVE=''
            for record in $${RECORDS}; do
              if [[ "$(gcloud storage cat "$${record}" | jq -r '.status')" == "live" ]]; then LIVE="$${record}"; fi
            done
            if [ -z "$${LIVE}" ]; then
              echo "Build REJECTED: release ${TAG_NAME} has deployment records in ${_PREVIOUS_ENV} but none is live: traffic never shifted to it there."
              exit 1
            fi
            echo "Gate passed: ${TAG_NAME} is live in ${_PREVIOUS_ENV} ($(gcloud storage cat "$${LIVE}" | jq -r '"since \(.timestamp), build \(.build)"'))"
          fi

  # The schema migrations, and the seed migrations beside them, are applied once each in
  # the order of their indexes, so each directory must be one contiguous sequence and a
  # committed migration never changes. This step refuses a build otherwise, before it
  # touches anything: a gap, two up files on one index, a name that is not a migration
  # (the rule bedrock check applies) and, in a pull-request build, a migration modified,
  # renamed or removed against the commit the branch started from, or an index the default
  # branch has taken since (the pull request's own migration is renumbered to the next
  # free index). The schema-protection workflow in the application's CI is the merge gate
  # for the same rule; this step is the deploy gate.
  - id: GuardMigrations
    waitFor: ["ValidateRelease"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 300s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi
        if [ "$${DOWN:-}" = "true" ]; then echo "Teardown: nothing to check."; exit 0; fi
        if [ -z "${_MIGRATIONS_DIR}" ]; then echo "No schema migrations: nothing to check."; exit 0; fi
        apt-get -qq update && apt-get -qq install -y jq
        API="https://api.github.com/repos/${REPO_FULL_NAME}"
        AUTH=(-s -H "Authorization: Bearer $${GITHUB_TOKEN}" -H "Accept: application/vnd.github.v3+json")
        BASE=""
        if [ -n "${_PR_NUMBER}" ]; then
          # The commit the pull request branched from: what its tree must still carry unchanged.
          BASE=$$(curl "$${AUTH[@]}" "$${API}/compare/${_DEFAULT_BRANCH}...${COMMIT_SHA}" | jq -r '.merge_base_commit.sha // empty')
          if [ -z "$${BASE}" ]; then echo "Build REJECTED: GitHub gave no merge base for ${_DEFAULT_BRANCH}...${COMMIT_SHA}."; exit 1; fi
        fi
        # listing: name<TAB>blob sha of a directory's files on a ref; nothing when the ref has no such directory.
        listing() {
          curl "$${AUTH[@]}" "$${API}/contents/$$1?ref=$$2" | jq -r 'if type == "array" then .[] | select(.type == "file") | "\(.name)\t\(.sha)" else empty end'
        }
        PROBLEMS=""
        for DIR in "${_MIGRATIONS_DIR}" "$$(dirname "${_MIGRATIONS_DIR}")/devseed"; do
          [ -d "$${DIR}" ] || continue
          # In a pull-request build, every file the branch started with is still there, unchanged...
          if [ -n "$${BASE}" ]; then
            while IFS=$$'\t' read -r NAME SHA; do
              [ -n "$${NAME}" ] || continue
              if [ ! -f "$${DIR}/$${NAME}" ]; then
                PROBLEMS+="  $${DIR}/$${NAME}: removed or renamed; a committed migration never changes"$$'\n'
              elif [ "$$(git hash-object "$${DIR}/$${NAME}")" != "$${SHA}" ]; then
                PROBLEMS+="  $${DIR}/$${NAME}: modified; a committed migration never changes, a new one follows it"$$'\n'
              fi
            done <<< "$$(listing "$${DIR}" "$${BASE}")"
          fi
          # ...and the sequence is read over the tree together with the default branch's, so an
          # index taken there since the branch was cut is seen now, not after the merge.
          declare -A UPS=() DOWNS=() UPN=() DOWNN=()
          NAMES=$$(ls "$${DIR}")
          if [ -n "$${BASE}" ]; then
            NAMES=$$( { echo "$${NAMES}"; listing "$${DIR}" "${_DEFAULT_BRANCH}" | cut -f1; } | sort -u )
          fi
          while read -r NAME; do
            [ -n "$${NAME}" ] || continue
            WHERE=""
            [ -e "$${DIR}/$${NAME}" ] || WHERE=" (on ${_DEFAULT_BRANCH}, not in this pull request)"
            if [[ "$${NAME}" =~ ^([0-9]{6})_[A-Za-z0-9_-]+\.(up|down)\.sql$$ ]]; then
              IDX="$${BASH_REMATCH[1]}"
              if [ "$${BASH_REMATCH[2]}" = "up" ]; then
                UPS[$${IDX}]+="$${NAME}$${WHERE}, "; UPN[$${IDX}]=$$(( $${UPN[$${IDX}]:-0} + 1 ))
              else
                DOWNS[$${IDX}]+="$${NAME}$${WHERE}, "; DOWNN[$${IDX}]=$$(( $${DOWNN[$${IDX}]:-0} + 1 ))
              fi
            elif [[ "$${NAME}" == *.sql ]]; then
              PROBLEMS+="  $${DIR}/$${NAME}: not a migration file name (NNNNNN_name.up.sql or NNNNNN_name.down.sql)"$$'\n'
            fi
          done <<< "$${NAMES}"
          INDEXES=$$(printf '%s\n' "$${!UPS[@]}" "$${!DOWNS[@]}" | grep . | sort -u || true)
          for IDX in $${INDEXES}; do
            if [ "$${UPN[$${IDX}]:-0}" -gt 1 ]; then PROBLEMS+="  $${DIR}: index $${IDX} has $${UPN[$${IDX}]} up files ($${UPS[$${IDX}]%, }); one migration per index"$$'\n'; fi
            if [ "$${DOWNN[$${IDX}]:-0}" -gt 1 ]; then PROBLEMS+="  $${DIR}: index $${IDX} has $${DOWNN[$${IDX}]} down files ($${DOWNS[$${IDX}]%, }); at most one"$$'\n'; fi
            if [ -z "$${UPS[$${IDX}]:-}" ]; then PROBLEMS+="  $${DIR}: index $${IDX} has a down file and no up file ($${DOWNS[$${IDX}]%, })"$$'\n'; fi
          done
          if [ -n "$${INDEXES}" ]; then
            LOW=$$(echo "$${INDEXES}" | head -1); HIGH=$$(echo "$${INDEXES}" | tail -1)
            for (( I=10#$${LOW}; I<=10#$${HIGH}; I++ )); do
              IDX=$$(printf '%06d' "$${I}")
              if [ -z "$${UPS[$${IDX}]:-}$${DOWNS[$${IDX}]:-}" ]; then PROBLEMS+="  $${DIR}: gap: no migration $${IDX} between $${LOW} and $${HIGH}; the sequence is contiguous so nothing is skipped"$$'\n'; fi
            done
            echo "$${DIR}: $${#UPS[@]} migration(s), $${LOW} to $${HIGH}$${BASE:+, read together with ${_DEFAULT_BRANCH}}."
          else
            echo "$${DIR}: no migrations."
          fi
          unset UPS DOWNS UPN DOWNN
        done
        if [ -n "$${PROBLEMS}" ]; then
          echo "Build REJECTED: the migrations are not one sequence the migrate command can apply in order (six-digit indexes, one up file each, contiguous, never changed once committed):"
          printf '%s' "$${PROBLEMS}"
          if [ -n "${_PR_NUMBER}" ]; then
            echo "A migration this pull request adds on an index ${_DEFAULT_BRANCH} has taken is renamed, up and down, to the next free index; a committed one is never renumbered."
            BODY=$$(jq -n --arg list "$${PROBLEMS}" --arg build "${BUILD_ID}" \
              '{body: ("The pull-request build stopped: the migrations are not one sequence the migrate command can apply in order (six-digit indexes, one up file each, contiguous, never changed once committed). Build " + $$build + ":\n\n```\n" + $$list + "```")}')
            curl -s -o /dev/null -w "Posted on the pull request: HTTP %{http_code}\n" -X POST \
              -H "Authorization: Bearer $${DEPLOYER_TOKEN:-$${GITHUB_TOKEN}}" -H "Accept: application/vnd.github.v3+json" \
              "$${API}/issues/${_PR_NUMBER}/comments" -d "$${BODY}"
          fi
          exit 1
        fi
        echo "Guard passed: the migrations form one sequence$${BASE:+, unchanged against ${_DEFAULT_BRANCH}}."

  # A pull request's environment is the same stack applied into the pull request's own
  # prefix as the tst apply identity (impersonated by the deploy identity; 2-env grants
  # it in tst only). Plan, guard, apply: the plan is saved, the guard reads it as JSON
  # and lets only the pull request's own resources through, and the apply applies
  # exactly that plan. /gcbrun shared-db plans without a database of its own, /gcbrun
  # reload-db replaces the pull request's database, /gcbrun down plans the destroy.
  - id: PlanPullRequestStack
    waitFor: ["GuardMigrations"]
    name: ghcr.io/opentofu/opentofu:1.12.6
    entrypoint: sh
    timeout: 900s
    args:
      - -c
      - |
        set -euf
        . /workspace/environment.sh

        if [ -z "${_PR_NUMBER}" ]; then
          echo "Tag build: the environment's stack is applied on its own rhythm, not here."
          exit 0
        fi

        cd infrastructure
        export GOOGLE_IMPERSONATE_SERVICE_ACCOUNT="${_APPLY_IDENTITY}"
        PREFIX="3-app/${_APP}/${_ENV}/pr${_PR_NUMBER}"
        echo "=== Pull request ${_PR_NUMBER}: stack at $${PREFIX} as ${_APPLY_IDENTITY} ==="
        tofu init -input=false -no-color \
          -backend-config="prefix=$${PREFIX}" \
          -backend-config="impersonate_service_account=${_APPLY_IDENTITY}"

        VARS="-var environment=${_ENV} -var pull_request=${_PR_NUMBER}"
        if [ "$${DOWN}" = "true" ]; then
          echo "=== /gcbrun down: planning the destroy of the pull request's environment ==="
          tofu plan -destroy -input=false -no-color -out=/workspace/pr.plan $${VARS}
        else
          if [ "$${SHARED_DB}" = "true" ]; then
            echo "=== /gcbrun shared-db: the site runs against ${_ENV}'s database; no database of its own ==="
            VARS="$${VARS} -var shared_database=true"
          fi
          if [ "$${RELOAD_DB}" = "true" ]; then
            echo "=== /gcbrun reload-db: the pull request's database is recreated ==="
            VARS="$${VARS} -replace=google_spanner_database.${_APP}[0]"
          fi
          tofu plan -input=false -no-color -out=/workspace/pr.plan $${VARS}
        fi
        tofu show -json /workspace/pr.plan > /workspace/pr-plan.json

  # The guard. A pull request may have edited the stack any way at all, so every
  # resource the plan creates, changes or destroys must carry the pull request's name
  # in what names it (name, account, service, job, database, parent, secret, service
  # account), or be an IAM membership naming one of the pull request's own accounts.
  # Anything else stops the run, and the offending addresses are posted on the pull
  # request. Resources outside the google provider (time_sleep) shape nothing and pass.
  # Shared mode is refused here too, when the pull request changes the migrations.
  - id: GuardPullRequestPlan
    waitFor: ["PlanPullRequestStack"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 300s
    args:
      - -c
      - |
        set -euo pipefail
        . /workspace/environment.sh

        if [ -z "${_PR_NUMBER}" ]; then
          echo "Tag build: nothing to guard."
          exit 0
        fi
        apt-get -qq update && apt-get -qq install -y jq
        PR_NAME="${_APP}-pr${_PR_NUMBER}"

        if [ "$${SHARED_DB}" = "true" ]; then
          CHANGED=$(curl -s -f -H "Authorization: Bearer $${GITHUB_TOKEN}" -H "Accept: application/vnd.github.v3+json" \
            "https://api.github.com/repos/${REPO_FULL_NAME}/compare/${_DEFAULT_BRANCH}...${COMMIT_SHA}" \
            | jq -r --arg dir "${_MIGRATIONS_DIR}/" '[.files[]? | select(.filename | startswith($$dir)) | .filename] | .[]')
          if [ -n "$${CHANGED}" ]; then
            echo "Build REJECTED: /gcbrun shared-db with changes under ${_MIGRATIONS_DIR} against ${_DEFAULT_BRANCH}; a migration on the shared database would change ${_ENV} before any release:"
            echo "$${CHANGED}" | sed 's/^/  /'
            exit 1
          fi
          echo "shared-db: nothing under ${_MIGRATIONS_DIR} changed against ${_DEFAULT_BRANCH}."
        fi

        OFFENDERS=$(jq -r --arg pr "$${PR_NAME}" '
          def ident: [.name?, .account_id?, .service?, .job?, .database?, .parent?, .secret_id?, .service_account_id?]
            | map(select(. != null) | tostring) | join(" ");
          [ .resource_changes[]?
            | select((.change.actions | map(select(. != "no-op" and . != "read")) | length) > 0)
            | select(.type | startswith("google_"))
            | . as $$c
            | ($$c.change.after // $$c.change.before // {}) as $$v
            | select(
                (($$v | ident) | contains($$pr))
                or (($$c.type | endswith("_iam_member")) and (($$v.member // "") | startswith("serviceAccount:" + $$pr + "-")))
                | not)
            | "\($$c.address) (\($$c.change.actions | join(",")))" ] | .[]' /workspace/pr-plan.json)
        COUNT=$(jq '[.resource_changes[]? | select((.change.actions | map(select(. != "no-op" and . != "read")) | length) > 0)] | length' /workspace/pr-plan.json)
        if [ -n "$${OFFENDERS}" ]; then
          echo "Build REJECTED: the plan touches resources that are not pull request ${_PR_NUMBER}'s:"
          echo "$${OFFENDERS}" | sed 's/^/  /'
          BODY=$(jq -n --arg name "$${PR_NAME}" --arg list "$${OFFENDERS}" --arg build "${BUILD_ID}" \
            '{body: ("The pull-request build stopped: its plan touches resources that do not belong to this pull request. A pull-request stack applies only resources named " + $$name + ", or memberships of its own accounts. Build " + $$build + ":\n\n```\n" + $$list + "\n```")}')
          curl -s -o /dev/null -w "Posted on the pull request: HTTP %{http_code}\n" -X POST \
            -H "Authorization: Bearer $${DEPLOYER_TOKEN:-$${GITHUB_TOKEN}}" -H "Accept: application/vnd.github.v3+json" \
            "https://api.github.com/repos/${REPO_FULL_NAME}/issues/${_PR_NUMBER}/comments" -d "$${BODY}"
          exit 1
        fi
        echo "Guard passed: $${COUNT} planned change(s), all pull request ${_PR_NUMBER}'s."

  - id: ApplyPullRequestStack
    waitFor: ["GuardPullRequestPlan"]
    name: ghcr.io/opentofu/opentofu:1.12.6
    entrypoint: sh
    timeout: 1800s
    args:
      - -c
      - |
        set -eu
        . /workspace/environment.sh

        if [ -z "${_PR_NUMBER}" ]; then
          echo "Tag build: nothing to apply."
          exit 0
        fi

        cd infrastructure
        export GOOGLE_IMPERSONATE_SERVICE_ACCOUNT="${_APPLY_IDENTITY}"
        tofu apply -input=false -no-color /workspace/pr.plan

        if [ "$${DOWN}" = "true" ]; then
          echo "=== /gcbrun down: the pull request's environment is gone; nothing deploys ==="
          echo 'export SKIP_DEPLOY="true"' >> /workspace/environment.sh
          exit 0
        fi

        # The stack's substitutions output names this pull request's services and job; the
        # JSON is one key per line, which sed reads without jq (absent from this image).
        tofu output -json substitutions > /workspace/pr-substitutions.json
        SERVICES=$(sed -n 's/.*"_SERVICES": *"\([^"]*\)".*/\1/p' /workspace/pr-substitutions.json)
        MIGRATE_JOB=$(sed -n 's/.*"_MIGRATE_JOB": *"\([^"]*\)".*/\1/p' /workspace/pr-substitutions.json)
        PR_HOSTNAME=$(sed -n 's/.*"_HOSTNAME": *"\([^"]*\)".*/\1/p' /workspace/pr-substitutions.json)
        if [ -z "$${SERVICES}" ] || [ -z "$${MIGRATE_JOB}" ]; then
          echo "Error: the pull request's stack named no services or no migrate job (see pr-substitutions.json)."
          exit 1
        fi
        echo "SERVICES=$${SERVICES} MIGRATE_JOB=$${MIGRATE_JOB}"
        {
          echo "export SERVICES=\"$${SERVICES}\""
          echo "export MIGRATE_JOB=\"$${MIGRATE_JOB}\""
          echo "export PR_HOSTNAME=\"$${PR_HOSTNAME}\""
        } >> /workspace/environment.sh

  # The application's hook after a pull-request environment is torn down (/gcbrun down or
  # the sweep), when it commits one at infrastructure/hooks/after-down.sh: third-party
  # registrations to undo, a notification. Only on a teardown.
  - id: HookAfterDown
    waitFor: ["ApplyPullRequestStack"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 900s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        HOOK="infrastructure/hooks/after-down.sh"
        if [ "$${DOWN:-}" != "true" ]; then echo "Not a teardown: nothing to run after down."; exit 0; fi
        if [ ! -e "$${HOOK}" ]; then echo "No hook at $${HOOK}: nothing to run after down."; exit 0; fi
        echo "=== Hook after-down: $${HOOK} ==="
        bash "$${HOOK}"

  # One image per environment, built fresh from this commit (no cache, nothing promoted from
  # another environment) and pushed under the commit and the release. Its digest is what
  # every later step deploys, so a revision is pinned to exactly this build.
  # A release names one build, and the registry's tags are immutable. When this
  # release's tag already exists the run is a retry: the tag must point at the image
  # this same commit produced, which BuildImage then reuses; a tag from another commit
  # stops the build instead of being overwritten. When only the commit's tag exists,
  # the commit was built here under another name and the release name is added to it.
  - id: CheckRelease
    waitFor: ["HookAfterDown"]
    name: gcr.io/google.com/cloudsdktool/cloud-sdk:slim
    entrypoint: bash
    timeout: 300s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi

        EXISTING=$(gcloud artifacts docker images describe "$${IMAGE}:$${IMAGE_TAG}" --format='value(image_summary.digest)' 2>/dev/null || true)
        BY_COMMIT=$(gcloud artifacts docker images describe "$${IMAGE}:$${COMMIT_TAG}" --format='value(image_summary.digest)' 2>/dev/null || true)
        if [ -z "$${EXISTING}" ]; then
          if [ -n "$${BY_COMMIT}" ]; then
            # The commit is the identity of a build: this environment already built this
            # commit under another release name (a tag moved, or a pull-request release
            # whose commit was fast-forwarded to master). The release name is added to
            # that build; nothing is rebuilt.
            echo "Commit ${COMMIT_SHA} is already built for ${_ENV} as $${IMAGE}@$${BY_COMMIT}; naming it $${IMAGE_TAG} and reusing it."
            gcloud artifacts docker tags add "$${IMAGE}:$${COMMIT_TAG}" "$${IMAGE}:$${IMAGE_TAG}"
            echo "export IMAGE_DIGEST=\"$${BY_COMMIT}\"" >> /workspace/environment.sh
            echo "export REUSE_IMAGE=\"true\"" >> /workspace/environment.sh
            exit 0
          fi
          echo "Release $${RELEASE} is not in the registry for ${_ENV} yet; BuildImage builds it."
          echo "export REUSE_IMAGE=\"\"" >> /workspace/environment.sh
          exit 0
        fi
        echo "Release tag digest: $${EXISTING}; commit tag digest: $${BY_COMMIT:-none}"
        if [[ "$${EXISTING}" != "$${BY_COMMIT}" ]]; then
          echo "Build REJECTED: $${IMAGE}:$${IMAGE_TAG} already exists and was not built from commit ${COMMIT_SHA}; a release names one build per environment."
          exit 1
        fi
        echo "Reusing $${IMAGE}:$${IMAGE_TAG}@$${EXISTING}, built from this commit by an earlier run."
        echo "export IMAGE_DIGEST=\"$${EXISTING}\"" >> /workspace/environment.sh
        echo "export REUSE_IMAGE=\"true\"" >> /workspace/environment.sh

  # The application's hook before the image build, when it commits one at
  # infrastructure/hooks/before-build.sh: run as the deploy identity in the checkout, with
  # the pipeline's facts (environment.sh) and every substitution of the build exported.
  # Files it writes are the Dockerfile's to copy (a fetched config, a frontend version
  # file); build arguments it appends to /workspace/build-args.sh (BUILD_ARGS+=(--build-arg
  # NAME=value)) reach the image build. No file, nothing runs; a failing hook stops the
  # build here.
  - id: HookBeforeBuild
    waitFor: ["CheckRelease"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 900s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        HOOK="infrastructure/hooks/before-build.sh"
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi
        if [ ! -e "$${HOOK}" ]; then echo "No hook at $${HOOK}: nothing to run before build."; exit 0; fi
        echo "=== Hook before-build: $${HOOK} ==="
        bash "$${HOOK}"

  - id: BuildImage
    waitFor: ["HookBeforeBuild"]
    name: gcr.io/cloud-builders/docker
    entrypoint: bash
    timeout: 1800s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        # The declared substitutions as build arguments, and whatever a hook before the
        # build appended (BUILD_ARGS+=(--build-arg NAME=value) lines).
        source /workspace/build-args.sh
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi

        # jq reads the build's metadata file.
        apt-get -qq update && apt-get -qq install -y jq

        if [[ "$${REUSE_IMAGE:-}" == "true" ]]; then
          echo "Reusing $${IMAGE}@$${IMAGE_DIGEST}: CheckRelease found this release already built from this commit."
          exit 0
        fi

        # Declared build secrets (_BUILD_SECRETS: NAME=<secret version>, comma-separated):
        # each is read as the deploy identity through the Secret Manager API and passed to
        # the build as a BuildKit secret the Dockerfile mounts (RUN --mount=type=secret,id=NAME).
        # The value lives in this step's memory-backed /dev/shm, gone with the step and
        # never in /workspace, so no later step sees it; it is never a build argument,
        # which the image would keep.
        SECRET_ARGS=()
        if [ -n "${_BUILD_SECRETS}" ]; then
          TOKEN=$$(curl -sf -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" | jq -r '.access_token')
          umask 077
          IFS=',' read -ra ENTRIES <<< "${_BUILD_SECRETS}"
          for ENTRY in "$${ENTRIES[@]}"; do
            NAME="$${ENTRY%%=*}"; VERSION="$${ENTRY#*=}"
            if ! curl -sf -H "Authorization: Bearer $${TOKEN}" "https://secretmanager.googleapis.com/v1/$${VERSION}:access" | jq -r '.payload.data' | base64 -d > "/dev/shm/$${NAME}"; then
              echo "Build REJECTED: the build secret $${NAME} ($${VERSION}) could not be read as the deploy identity; the stack grants it accessor on the container, and the version must exist and be enabled."
              exit 1
            fi
            SECRET_ARGS+=(--secret "id=$${NAME},src=/dev/shm/$${NAME}")
            echo "Build secret $${NAME}: $${VERSION} ($$(wc -c < "/dev/shm/$${NAME}") bytes)"
          done
        fi

        docker buildx build \
          --build-arg VERSION="$${VERSION}" \
          --build-arg COMMIT="${COMMIT_SHA}" \
          $${BUILD_ARGS[@]+"$${BUILD_ARGS[@]}"} \
          $${SECRET_ARGS[@]+"$${SECRET_ARGS[@]}"} \
          --tag "$${IMAGE}:$${COMMIT_TAG}" \
          --tag "$${IMAGE}:$${IMAGE_TAG}" \
          --metadata-file /workspace/image-metadata.json \
          --file Dockerfile --no-cache --push .

        IMAGE_DIGEST=$(jq -r '."containerimage.digest"' /workspace/image-metadata.json)
        if [[ -z "$${IMAGE_DIGEST}" || "$${IMAGE_DIGEST}" == "null" ]]; then
          echo "Error: no image digest in /workspace/image-metadata.json."
          exit 1
        fi
        echo "export IMAGE_DIGEST=\"$${IMAGE_DIGEST}\"" >> /workspace/environment.sh
        echo "Built and pushed $${IMAGE}@$${IMAGE_DIGEST}"

  # The application's hook before the migrations, when it commits one at
  # infrastructure/hooks/before-migrate.sh, with the image built and its digest in
  # IMAGE_DIGEST; the same facts and substitutions as the hook before the build.
  - id: HookBeforeMigrate
    waitFor: ["BuildImage"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 900s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        HOOK="infrastructure/hooks/before-migrate.sh"
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi
        if [ ! -e "$${HOOK}" ]; then echo "No hook at $${HOOK}: nothing to run before migrate."; exit 0; fi
        echo "=== Hook before-migrate: $${HOOK} ==="
        bash "$${HOOK}"

  # The migrate command (the schema migrations, then the roles file) as a Cloud Run job in
  # the first region, run to completion before any revision that expects the new schema
  # exists. One job serves the environment; each deploy updates it to this image. A
  # pull-request build skips it unless its comment said reload-db.
  - id: RunMigrations
    waitFor: ["HookBeforeMigrate"]
    name: gcr.io/google.com/cloudsdktool/cloud-sdk:slim
    entrypoint: bash
    timeout: 2400s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi

        if [[ "$${RUN_MIGRATIONS}" != "true" ]]; then
          echo "Skipping the migrate job: this build does not run migrations."
          exit 0
        fi

        # Cloud Build substitutes a plain dollar-brace name only, and it reads the whole
        # script for them, so the region=name pair is copied into a shell variable before
        # the shell splits it with a parameter expansion.
        JOB_NAME="$${MIGRATE_JOB#*=}"
        REGION="$${MIGRATE_JOB%%=*}"

        LABELS="managed-by=cloudbuild,commit-sha=${COMMIT_SHA},gcb-build-id=${BUILD_ID},source_repo=${REPO_NAME},environment=${_ENV}"
        if [ -n "${_PR_NUMBER}" ]; then LABELS+=",pr-number=${_PR_NUMBER}"; fi

        echo "=== Updating job [$${JOB_NAME}] in [$${REGION}] to this image ==="
        # Only the image and the labels change: the job's variables, identity, resources
        # and retry policy are the application layer's.
        gcloud run jobs update "$${JOB_NAME}" \
          --project="${_PROJECT}" \
          --region="$${REGION}" \
          --image="$${IMAGE}@$${IMAGE_DIGEST}" \
          --labels="$${LABELS}" \
          --quiet

        echo "=== Running job [$${JOB_NAME}] ==="
        # --wait blocks until the execution ends and fails this step when it fails.
        # The seed: where _SEED is true (every pull request, its database being new; a
        # release build only in the environments the placement's seed list names, none by
        # default and never production), the job applies schema/devseed as data migrations
        # after the schema; a seeded database takes nothing twice, so this is safe to pass
        # on every run.
        SEED_ARGS=""
        if [ "${_SEED}" = "true" ]; then
          SEED_ARGS="--args=-seed"
          echo "Seeding: the migrate job applies schema/devseed as data migrations."
        fi
        gcloud run jobs execute "$${JOB_NAME}" $${SEED_ARGS} \
          --project="${_PROJECT}" \
          --region="$${REGION}" \
          --wait \
          --quiet

  # A new revision of the service in every region, receiving no traffic yet. The service
  # itself is the infrastructure's (created with its runtime identity, ingress, and scaling);
  # this step only updates it. Before each update the service is checked for the state a
  # failed earlier deploy leaves behind (traffic pointed at a revision that is not ready)
  # and repaired by moving traffic back to the last ready revision, as CCC's deployments do.
  - id: DeployServiceNoTraffic
    waitFor: ["RunMigrations"]
    name: gcr.io/google.com/cloudsdktool/cloud-sdk:slim
    entrypoint: bash
    timeout: 1200s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi

        # jq reads the service's state and the update's answer.
        apt-get -qq update && apt-get -qq install -y jq

        # The last ready revision of a service whose traffic points at a revision that is
        # not ready; empty when the service is consistent.
        last_ready_if_inconsistent() {
          gcloud run services describe "$$1" --project="${_PROJECT}" --region="$$2" --format=json | \
          jq -r 'select(
            (.spec.traffic[0].revisionName != .status.traffic[0].revisionName) and
            ((.status.conditions[] | select(.type=="Ready")).status == "False")
          ) | .status.latestReadyRevisionName'
        }

        # Only the image and the labels change: the service's variables, secret mounts,
        # identity and scaling are the application layer's.
        # A pull-request revision is reachable through its tag's URL and nothing else.
        TAG_ARGS=()
        if [ -n "$${REVISION_TAG}" ]; then TAG_ARGS=(--tag="$${REVISION_TAG}"); fi

        LABELS="managed-by=cloudbuild,commit-sha=${COMMIT_SHA},gcb-build-id=${BUILD_ID},source_repo=${REPO_NAME},environment=${_ENV}"
        if [ -n "${_PR_NUMBER}" ]; then LABELS+=",pr-number=${_PR_NUMBER}"; fi

        # One line per region for the next steps: region, service, revision.
        REVISIONS_FILE="/workspace/revisions.txt"
        : > "$${REVISIONS_FILE}"

        IFS=',' read -r -a SERVICES <<< "$${SERVICES}"
        for ENTRY in "$${SERVICES[@]}"; do
          REGION="$${ENTRY%%=*}"
          SERVICE_NAME="$${ENTRY#*=}"
          echo "--- Service [$${SERVICE_NAME}] in region [$${REGION}] ---"

          LAST_READY=$(last_ready_if_inconsistent "$${SERVICE_NAME}" "$${REGION}")
          if [[ -n "$${LAST_READY}" && "$${LAST_READY}" != "null" ]]; then
            echo "PROBLEM: service [$${SERVICE_NAME}] is in an inconsistent state; moving traffic back to [$${LAST_READY}]..."
            # The exit status is deliberately ignored: gcloud has reported an error here
            # while the traffic did move, so the state is checked again instead.
            gcloud run services update-traffic "$${SERVICE_NAME}" \
              --project="${_PROJECT}" \
              --region="$${REGION}" \
              --to-revisions="$${LAST_READY}=100" \
              --quiet || echo "gcloud reported an error; checking whether the traffic moved anyway..."
            POST_FIX=$(last_ready_if_inconsistent "$${SERVICE_NAME}" "$${REGION}")
            if [[ -z "$${POST_FIX}" || "$${POST_FIX}" == "null" ]]; then
              echo "FIX VERIFIED: traffic for [$${SERVICE_NAME}] is consistent again."
            else
              echo "FIX FAILED: service [$${SERVICE_NAME}] is still inconsistent [$${POST_FIX}]."
              exit 1
            fi
          else
            echo "HEALTH CHECK PASSED: service [$${SERVICE_NAME}] is consistent."
          fi

          echo "Deploying revision to [$${SERVICE_NAME}] without traffic..."
          REVISION_NAME=$(gcloud run services update "$${SERVICE_NAME}" \
            --project="${_PROJECT}" \
            --region="$${REGION}" \
            --image="$${IMAGE}@$${IMAGE_DIGEST}" \
            --labels="$${LABELS}" \
            "$${TAG_ARGS[@]}" \
            --no-traffic \
            --quiet \
            --format=json | jq -r '.status.latestCreatedRevisionName')
          if [[ -z "$${REVISION_NAME}" || "$${REVISION_NAME}" == "null" ]]; then
            echo "Error: the deployment to region $${REGION} failed, or its revision name could not be read."
            exit 1
          fi
          echo "Revision [$${REVISION_NAME}] deployed to [$${SERVICE_NAME}] in [$${REGION}]"
          echo "$${REGION},$${SERVICE_NAME},$${REVISION_NAME}" >> "$${REVISIONS_FILE}"
        done

  # Every region to 100 percent on its new revision. A pull-request build leaves traffic
  # where it is: its revision is served under its tag.
  - id: ShiftTraffic
    waitFor: ["DeployServiceNoTraffic"]
    name: gcr.io/google.com/cloudsdktool/cloud-sdk:slim
    entrypoint: bash
    timeout: 600s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi

        REVISIONS_FILE="/workspace/revisions.txt"
        if [ ! -s "$${REVISIONS_FILE}" ]; then
          echo "Error: $${REVISIONS_FILE} is missing or empty; no revision was deployed."
          exit 1
        fi

        if [[ "$${SHIFT_TRAFFIC}" != "true" ]]; then
          echo "Leaving traffic unchanged: a pull-request revision is served under its tag only."
          exit 0
        fi

        while IFS=',' read -r REGION SERVICE_NAME REVISION_NAME; do
          echo "--- Shifting traffic in [$${REGION}] to [$${REVISION_NAME}] ---"
          gcloud run services update-traffic "$${SERVICE_NAME}" \
            --project="${_PROJECT}" \
            --region="$${REGION}" \
            --to-revisions="$${REVISION_NAME}=100" \
            --quiet
        done < "$${REVISIONS_FILE}"

  # The application's hook after traffic moved, when it commits one at
  # infrastructure/hooks/after-traffic.sh: a smoke test, a cache warm, a notification. A
  # failing hook fails the build before the deployment record is written, so the record
  # gate never sees a release the hook refused.
  - id: HookAfterTraffic
    waitFor: ["ShiftTraffic"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 900s
    args:
      - -c
      - |
        set -euo pipefail
        source /workspace/environment.sh
        HOOK="infrastructure/hooks/after-traffic.sh"
        if [ "$${SKIP_DEPLOY:-}" = "true" ]; then echo "The pull request's environment was torn down: nothing to do."; exit 0; fi
        if [ ! -e "$${HOOK}" ]; then echo "No hook at $${HOOK}: nothing to run after traffic."; exit 0; fi
        echo "=== Hook after-traffic: $${HOOK} ==="
        bash "$${HOOK}"

  # The record of what is now running, written by bedrock deploy record from the bedrock
  # image the placement pins (bedrockImage): the version, commit, image and digest, the
  # regions and the revision each runs, the time, and live or preview. The next
  # environment's gate reads it. It reads environment.sh, build.json and revisions.txt.
  - id: WriteDeploymentRecord
    waitFor: ["HookAfterTraffic"]
    name: {{.P.BedrockImage}}
    args: [deploy, record]
    timeout: 300s

  # Talk back on the pull request as the deployer app: a GitHub deployment named
  # after the environment, carrying its URL (the pull request's sidebar shows it, and
  # "View deployment" opens it), and a comment with the release and the database
  # mode; /gcbrun down marks every deployment of the environment inactive. Skipped
  # without a token (a tag build, or no deployer app in the environment yet).
  - id: TalkBack
    waitFor: ["WriteDeploymentRecord"]
    name: gcr.io/cloud-builders/gcloud
    entrypoint: bash
    timeout: 120s
    args:
      - -c
      - |
        set -euo pipefail
        . /workspace/environment.sh
        if [ -z "${_PR_NUMBER}" ] || [ -z "$${DEPLOYER_TOKEN:-}" ]; then
          echo "No talk-back."
          exit 0
        fi
        apt-get -qq update && apt-get -qq install -y jq
        API="https://api.github.com/repos/${REPO_FULL_NAME}"
        AUTH=(-s -f -H "Authorization: Bearer $${DEPLOYER_TOKEN}" -H "Accept: application/vnd.github+json")
        ENVIRONMENT="${_APP}-pr${_PR_NUMBER}"
        LOG_URL="https://console.cloud.google.com/cloud-build/builds;region=${LOCATION}/${BUILD_ID}?project=${PROJECT_ID}"
        if [ "$${DOWN}" = "true" ]; then
          for DEPLOYMENT in $(curl "$${AUTH[@]}" "$${API}/deployments?environment=$${ENVIRONMENT}&per_page=100" | jq -r '.[].id'); do
            curl "$${AUTH[@]}" -o /dev/null -X POST "$${API}/deployments/$${DEPLOYMENT}/statuses" \
              -d "{\"state\":\"inactive\",\"log_url\":\"$${LOG_URL}\",\"description\":\"Destroyed by /gcbrun down\"}"
          done
          BODY="The environment $${ENVIRONMENT} is destroyed (/gcbrun down, build ${BUILD_ID})."
        else
          URL="https://$${PR_HOSTNAME}/"
          DEPLOYMENT=$(curl "$${AUTH[@]}" -X POST "$${API}/deployments" \
            -d "{\"ref\":\"${COMMIT_SHA}\",\"environment\":\"$${ENVIRONMENT}\",\"transient_environment\":true,\"auto_merge\":false,\"required_contexts\":[],\"description\":\"Cloud Build ${BUILD_ID}\"}" | jq -r '.id')
          curl "$${AUTH[@]}" -o /dev/null -X POST "$${API}/deployments/$${DEPLOYMENT}/statuses" \
            -d "{\"state\":\"success\",\"environment_url\":\"$${URL}\",\"log_url\":\"$${LOG_URL}\",\"auto_inactive\":true,\"description\":\"Deployed $${RELEASE}\"}"
          MODE="its own database"
          if [ "$${SHARED_DB}" = "true" ]; then MODE="${_ENV}'s database (shared-db)"; fi
          BODY="Deployed $${RELEASE} to $${URL} with $${MODE} (build ${BUILD_ID})."
        fi
        curl "$${AUTH[@]}" -o /dev/null -X POST "$${API}/issues/${_PR_NUMBER}/comments" -d "$(jq -n --arg body "$${BODY}" '{body: $$body}')"
        echo "Talked back on pull request ${_PR_NUMBER}: $${BODY}"

options:
  logging: CLOUD_LOGGING_ONLY

# The whole run: the image build and the migrate job are the long steps.
timeout: 5400s

# Defaults a trigger may override. _PR_NUMBER is not one of them: the pull-request
# event sets it, and a default here would win over the event and leave it empty
# (the first triggered pull-request build, 2026-09-26). The version trigger and a
# hand-submitted build pass _PR_NUMBER as the empty string themselves. Everything
# else (the target: _ENV, _APP, _PROJECT, the services and the job, the registry,
# the records bucket, the connection) comes from the trigger, which the
# application's infrastructure layer creates with those values.
substitutions:
  _DEFAULT_BRANCH: master
