# {{.App}}'s deploy pipeline: the Cloud Build steps that take one commit into one environment,
# in the sequence CCC's deployments use. Rendered by bedrock from its pipeline template and
# owned by it: bedrock render rewrites this file and bedrock check compares it with the code,
# so a change belongs in bedrock, never here.
#
# Every step but the first runs one bedrock command. The first gets the bedrock the placement
# pins: a release's binary, downloaded and verified against its checksum, or a commit, built
# with go install and verified by Go's checksum database. Each step after it runs that bedrock
# in the image whose tool it drives (gcloud's for most, OpenTofu's for the pull request's
# stack, docker's for the image build). The steps share the workspace, which is the checkout:
# resolve writes the facts (environment.sh) and the build (build.json), and each step reads
# them, does one thing, and appends what it learned. No step after the first installs
# anything. What each command does in full: bedrock deploy <command> --help.
#
#   FetchBedrock              the pinned bedrock: a release verified against its checksum, or a commit built with go install
#   ResolveDeploymentTarget   what is deployed and where (deploy resolve)
#   ValidateRelease           whether this release may deploy here (deploy validate-release)
#   GuardMigrations           the migrations are one sequence, unchanged once committed (deploy guard-migrations)
#   *PullRequestStack         a pull request's own environment: plan, guard, apply (deploy pr-stack)
#   CheckRelease              a release already built from this commit is reused (deploy check-release)
#   BuildImage                one image per environment, built fresh from the commit and pushed (deploy build-image)
#   RunMigrations             the migrate command as a Cloud Run job, run to completion (deploy migrate)
{{- if .Jobs}}
#   DeployJobs                the job process's Cloud Run job updated to this image, not run (deploy jobs)
{{- end}}
#   DeployServiceNoTraffic    a new revision in every region, receiving no traffic yet (deploy service)
#   ShiftTraffic              every region to 100 percent on its new revision (deploy shift-traffic)
#   WriteDeploymentRecord     the record of what is now running, which the next environment's gate reads (deploy record)
#   TalkBack                  the pull request is told what the build did (deploy talk-back)
#   Hook*                     the application's own hooks, one step per stage it implements (deploy hook <stage>)
#
# The revision template (variables, secret mounts, identity, scaling) belongs to the
# application's infrastructure layer; a deploy changes the image and stamps its labels,
# nothing else, so a later apply of that layer and a deploy never fight over the same fields.
#
# Two kinds of trigger run it (README.md, "Deploying"): a version trigger per environment, on
# a release tag; and the pull-request trigger for {{.Integration}}, started by a "/gcbrun" comment,
# which stands the pull request's own environment up (or down, on "/gcbrun down").
#
# The steps run in the order written: a step with no waitFor waits for every step before it.

steps:
{{- if .CommitPin}}
  # The bedrock every later step runs: the commit the placement pins (bedrockVersion, a
  # commit pin), built with go install in the Go image pinned by digest into the home
  # directory the steps share. Go's checksum database verifies the module, and bedrock's
  # go.sum its dependencies, in place of a checksum in the placement. The one place a
  # bedrock version appears; bedrock upgrade moves it.
{{- else}}
  # The bedrock every later step runs: the release the placement pins (bedrockVersion),
  # downloaded from its GitHub Release into the home directory the steps share and verified
  # against the placement's checksum (bedrockSha256) before anything runs it. The one place
  # a bedrock version appears; bedrock upgrade moves it.
{{- end}}
{{.FetchBedrockStep}}
  # What is deployed and where: the trigger's kind, the environment, the /gcbrun comment's
  # options, the image and its tags. Writes environment.sh, build.json and build-args.txt.
  - id: ResolveDeploymentTarget
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, resolve]
    env: ["BUILD_ID=$BUILD_ID", "PROJECT_ID=$PROJECT_ID", "LOCATION=$LOCATION"]
    timeout: 300s

  # A tag build only: the tag is a release cut by the release app, its commit is on the
  # default branch (or tips its hotfix line), and the previous environment runs it live.
  - id: ValidateRelease
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, validate-release]
    timeout: 300s

  # The schema migrations and the seed are each one contiguous sequence, and in a
  # pull-request build unchanged against the default branch; a refusal names the fix.
  - id: GuardMigrations
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, guard-migrations]
    timeout: 300s

  # A pull-request build only: the stack applied into the pull request's own prefix as the
  # apply identity. The plan is saved, the guard lets only the pull request's own resources
  # through, and the apply applies exactly that plan (a destroy on /gcbrun down).
  - id: PlanPullRequestStack
    name: {{.OpenTofuImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, pr-stack, plan]
    timeout: 900s

  - id: GuardPullRequestPlan
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, pr-stack, guard]
    timeout: 300s

  - id: ApplyPullRequestStack
    name: {{.OpenTofuImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, pr-stack, apply]
    timeout: 1800s
{{- if .HasHook "after-down"}}

  # The application's hook after a teardown: {{.HookSource "after-down"}}.
  - id: HookAfterDown
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, hook, after-down]
    timeout: 900s
{{- end}}

  # Whether the image build runs: a release already built from this commit is reused, and
  # a release tag naming another build is refused.
  - id: CheckRelease
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, check-release]
    timeout: 300s
{{- if .HasHook "before-build"}}

  # The application's hook before the image build: {{.HookSource "before-build"}}. Build
  # arguments it appends to build-args.txt (NAME=value lines) reach the build.
  - id: HookBeforeBuild
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, hook, before-build]
    timeout: 900s
{{- end}}

  # The image, built fresh from the commit's Dockerfile with the declared build arguments
  # and build secrets, pushed under <release>-<env> and <commit>-<env>.{{if .HookProgram}} The hooks
  # program (/hooks) is taken out of it for the hook steps after it.{{end}}
  - id: BuildImage
    name: {{.DockerImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, build-image{{if .HookProgram}}, --hooks{{end}}]
    timeout: 1800s
{{- if .HasHook "before-migrate"}}

  # The application's hook before the migrations: {{.HookSource "before-migrate"}}.
  - id: HookBeforeMigrate
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, hook, before-migrate{{if .HookByProgram "before-migrate"}}, --program{{end}}]
    timeout: 900s
{{- end}}

  # The migrate job on this image, run to completion; with the seed in a pull request and
  # in the environments the placement's seed list names.
  - id: RunMigrations
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, migrate]
    timeout: 2400s
{{- if .HasHook "after-migrate"}}

  # The application's hook after the migrations: {{.HookSource "after-migrate"}}.
  - id: HookAfterMigrate
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, hook, after-migrate{{if .HookByProgram "after-migrate"}}, --program{{end}}]
    timeout: 900s
{{- end}}
{{- if .Jobs}}

  # This build's job for the job process ({{.Jobs.Dir}}): a copy of the stack's template
  # job on this image, named after the version; not run. Only the running service
  # starts it.
  - id: DeployJobs
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, jobs]
    timeout: 600s
{{- end}}

  # A new revision in every region, receiving no traffic yet, tagged "next" (or the pull
  # request's tag) so it can be reached before traffic moves.
  - id: DeployServiceNoTraffic
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, service]
    timeout: 1200s
{{- if .HasHook "before-traffic"}}

  # The application's hook before traffic moves: {{.HookSource "before-traffic"}}. NEXT_URL
  # and REVISION_URLS reach the new revision while the old one still serves; a failing hook
  # stops the build with the old revision serving.
  - id: HookBeforeTraffic
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, hook, before-traffic{{if .HookByProgram "before-traffic"}}, --program{{end}}]
    timeout: 900s
{{- end}}

  # Every region to 100 percent on its new revision; a pull request's revision stays under
  # its tag.
  - id: ShiftTraffic
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, shift-traffic]
    timeout: 600s
{{- if .Jobs}}

  # The job process's jobs no revision runs any more are deleted: not serving, not among
  # the five newest revisions, no execution running. The template and this build's stay.
  - id: SweepJobs
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, sweep-jobs]
    timeout: 600s
{{- end}}
{{- if .HasHook "after-traffic"}}

  # The application's hook after traffic moved: {{.HookSource "after-traffic"}}. A failing
  # hook fails the build before the record is written, so the gate never sees the release.
  - id: HookAfterTraffic
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, hook, after-traffic{{if .HookByProgram "after-traffic"}}, --program{{end}}]
    timeout: 900s
{{- end}}

  # The record of what now runs, in the records bucket; the next environment's gate reads it.
  - id: WriteDeploymentRecord
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, record]
    timeout: 300s

  # A pull-request build only, as the deployer app: a GitHub deployment carrying the
  # environment's URL and a comment with the release and the database mode.
  - id: TalkBack
    name: {{.GcloudImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, talk-back]
    timeout: 120s

options:
  logging: CLOUD_LOGGING_ONLY
  # The bedrock deploy steps read the build's substitutions through the API, so this file
  # no longer names every one a trigger or a hand submission passes; without this, Cloud
  # Build refuses a hand-submitted build for a key the file does not mention.
  substitutionOption: ALLOW_LOOSE

# The whole run: the image build and the migrate job are the long steps, and a commit
# pin's FetchBedrock builds bedrock where a release pin's downloads it.
timeout: {{.PipelineTimeout}}

# Defaults a trigger may override. _PR_NUMBER is not one of them: the pull-request
# event sets it, and a default here would win over the event and leave it empty
# (the first triggered pull-request build, 2026-09-26). The version trigger and a
# hand-submitted build pass _PR_NUMBER as the empty string themselves. Everything
# else (the target: _ENV, _APP, _PROJECT, the services and the job, the registry,
# the records bucket, the connection) comes from the trigger, which the
# application's infrastructure layer creates with those values.
substitutions:
  _DEFAULT_BRANCH: master
