# {{.App}}'s sweep, rendered by bedrock from its template and owned by it (bedrock render
# rewrites this file, bedrock check compares it): the environments of closed pull requests
# are destroyed. Cloud Scheduler runs the sweep trigger (infrastructure/cloud-build.tf) every
# hour as the deploy identity with the pipeline's substitutions; nothing else runs this file.
# Closing or merging a pull request starts no build, so this is how an environment nobody
# took down with /gcbrun down goes away.
steps:
  # The pinned bedrock, {{if .CommitPin}}built with go install{{else}}downloaded and verified{{end}}, as the pipeline's first step does it.
{{.FetchBedrockStep}}
  # The pull requests whose services stand, which of them GitHub says are closed, and each
  # closed one's stack destroyed as the apply identity from its own prefix (deploy sweep).
  - id: SweepClosedPullRequests
    name: {{.OpenTofuImage}}
    entrypoint: /builder/home/bedrock
    args: [deploy, sweep]
    env: ["BUILD_ID=$BUILD_ID", "PROJECT_ID=$PROJECT_ID", "LOCATION=$LOCATION"]
    timeout: {{.SweepStepTimeout}}

options:
  logging: CLOUD_LOGGING_ONLY

# The whole run: FetchBedrock's timeout, the sweep's, and time to pull the images.
timeout: {{.SweepTimeout}}
