{
  "outlets": {
    "default": {
      "oldestAnswered": "0.0.1"
    }
  },
  "scheduled": [
    {
      "path": "/_scheduled/close-stale-holds",
      "schedule": "*/15 * * * *",
      "timeZone": "UTC"
    }
  ],
  "fileRoutes": [
    {
      "kind": "file",
      "method": "GET",
      "path": "/api/notices/{id}/file",
      "source": "Notice.Key"
    }
  ],
  "surfaces": [
    {
      "prefix": "/_scheduled/close-stale-holds",
      "kind": "route",
      "log": "always"
    },
    {
      "prefix": "/api/",
      "kind": "prefix",
      "log": "onEvent"
    }
  ]
}
