# ---------------------------------------------------------------------------
# The GitHub Apps' keys
#
{{- if .IsRoot}}
# The three GitHub Apps' private keys live here, in this organization's boot
# project, for every bedrock organization in the Google Cloud organization:
# one secret per app, each version a key, and on each secret the alias
# "current", which placement.json pins (githubInfrastructureKeyVersion,
# githubDeployerKeyVersion, githubReleaseKeyVersion) and this layer's apply
# moves. Every reader, this organization's runs and the hosting
# organizations' pipelines, names the alias, never a number and never latest,
# so adding a version changes nothing by itself and one pull request here
# switches every reader at once (README, "Rotating a GitHub App's key"):
#
#   {{.InfrastructureKeySecret}}  the infrastructure GitHub App, whose
#     installation token 1-dns's GitHub provider needs here and the second
#     layer's in each hosting organization. A run of the triggers mints it from the key
#     (cloud-build.tf); a person applying by hand uses their own token.
#   {{.DeployerKeySecret}}  the deployer GitHub App, which the plan trigger's
#     run posts each layer's plan on the pull request as, here and in each
#     hosting organization, and which every application's pipeline talks
#     back on its pull requests as.
#   {{.ReleaseKeySecret}}  the release GitHub App, which cuts every
#     application's releases in the hosting organizations; nothing here reads
#     it.
#
# A key is added by the key operators placement.json names (keyOperators: the
# adding of a version, and the read that proves it before the alias moves),
# never by a layer. Each hosting organization's boot identity
# (hostingOrganizations) holds the three secrets' policy administration,
# secretPolicyAdmin: a secret's IAM policy and nothing else, which that
# organization's layers hand down to the identities that read a key. That
# grant is the only reach a hosting organization has into this one. The dns
# identity administers the two secrets it reads from (and reads the
# infrastructure key for 1-dns's apply); 1-dns's plan identity (bootstrap.tf)
# reads the infrastructure key too, since a plan of 1-dns reads the
# repository. The runners' reads are cloud-build.tf's. No key reaches GitHub.
# ---------------------------------------------------------------------------

locals {
  keys_project = module.boot_project.project_id
  key_secrets = {
    infrastructure = google_secret_manager_secret.github_infrastructure_key.secret_id
    deployer       = google_secret_manager_secret.github_deployer_key.secret_id
    release        = google_secret_manager_secret.github_release_key.secret_id
  }

  # The hosting organizations that read the keys, each by its boot identity
  # (placement.json, hostingOrganizations).
  hosting_boot_identities = {
{{- range .HostingOrganizations}}
    {{.Prefix}} = "{{.BootIdentityMember}}"
{{- end}}
  }
  hosting_key_grants = {
    for pair in setproduct(keys(local.hosting_boot_identities), keys(local.key_secrets)) :
    "${pair[0]}__${pair[1]}" => { organization = pair[0], key = pair[1] }
  }

  # The key operators (placement.json, keyOperators), each with the adding of
  # a version and the read of one, on each of the three secrets.
  key_operators = {{.KeyOperatorsHCL}}
  key_operator_grants = {
    for pair in setproduct(local.key_operators, keys(local.key_secrets), ["roles/secretmanager.secretVersionAdder", "roles/secretmanager.secretAccessor"]) :
    "${pair[0]}__${pair[1]}__${pair[2]}" => { member = pair[0], key = pair[1], role = pair[2] }
  }
}

resource "google_secret_manager_secret" "github_infrastructure_key" {
  project   = module.boot_project.project_id
  secret_id = "${var.prefix}-boot-gbl-github-infrastructure-key"

  replication {
    auto {}
  }

  labels          = local.labels
  version_aliases = {{.KeyAliasHCL "github-infrastructure-key"}}
}

resource "google_secret_manager_secret" "github_deployer_key" {
  project   = module.boot_project.project_id
  secret_id = "${var.prefix}-boot-gbl-github-deployer-key"

  replication {
    auto {}
  }

  labels          = local.labels
  version_aliases = {{.KeyAliasHCL "github-deployer-key"}}
}

resource "google_secret_manager_secret" "github_release_key" {
  project   = module.boot_project.project_id
  secret_id = "${var.prefix}-boot-gbl-github-release-key"

  replication {
    auto {}
  }

  labels          = local.labels
  version_aliases = {{.KeyAliasHCL "github-release-key"}}
}

# Reads and sets a secret's IAM policy, nothing else: no payload, no version,
# no change to the secret. The role the hosting organizations' identities
# hold on the three secrets, so each can grant its own identities the read. A
# role in this project, where the secrets are.
resource "google_project_iam_custom_role" "secret_policy_admin" {
  project     = module.boot_project.project_id
  role_id     = "secretPolicyAdmin"
  title       = "Secret Policy Admin"
  description = "Reads and sets a secret's IAM policy, for the organizations whose layers grant their identities the read of a GitHub App's key held here; no payload, no version, no change to the secret."
  permissions = [
    "secretmanager.secrets.get",
    "secretmanager.secrets.getIamPolicy",
    "secretmanager.secrets.setIamPolicy",
  ]
}

resource "google_secret_manager_secret_iam_member" "hosting_boot_tofu_keys" {
  for_each = local.hosting_key_grants

  project   = module.boot_project.project_id
  secret_id = local.key_secrets[each.value.key]
  role      = google_project_iam_custom_role.secret_policy_admin.id
  member    = local.hosting_boot_identities[each.value.organization]
}

resource "google_secret_manager_secret_iam_member" "key_operators" {
  for_each = local.key_operator_grants

  project   = module.boot_project.project_id
  secret_id = local.key_secrets[each.value.key]
  role      = each.value.role
  member    = each.value.member
}

resource "google_secret_manager_secret_iam_member" "org_tofu_infrastructure_key" {
  project   = module.boot_project.project_id
  secret_id = google_secret_manager_secret.github_infrastructure_key.secret_id
  role      = "roles/secretmanager.admin"
  member    = google_service_account.org_tofu.member
}

resource "google_secret_manager_secret_iam_member" "org_tofu_deployer_key" {
  project   = module.boot_project.project_id
  secret_id = google_secret_manager_secret.github_deployer_key.secret_id
  role      = "roles/secretmanager.admin"
  member    = google_service_account.org_tofu.member
}

# A plan of 1-dns reads this repository with the infrastructure app's token,
# minted from the key: the dns plan identity reads that one secret.
resource "google_secret_manager_secret_iam_member" "org_plan_infrastructure_key" {
  project   = module.boot_project.project_id
  secret_id = google_secret_manager_secret.github_infrastructure_key.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.boot_plan["dns"].member
}

# The boot identity manages the secrets, their aliases and their policies when
# this layer runs through the apply trigger, and the token secret's policy
# (cloud-build.tf); the break-glass account's Owner covered the first apply.
resource "google_project_iam_member" "boot_tofu_secrets" {
  project = module.boot_project.project_id
  role    = "roles/secretmanager.admin"
  member  = google_service_account.boot_tofu.member
}
{{- else}}
# The three GitHub Apps' private keys live in the root organization
# {{.RootOrganization}}'s boot project ({{.RootProject}}; root in placement.json), one
# secret per app for every bedrock organization in the Google Cloud
# organization, and every reader here names a secret's alias "current", which
# that organization's placement pins and its apply moves: a key is never added
# or pinned in this repository, and a rotation there switches every reader at
# once (that organization's 0-bootstrap/README.md, "Rotating a GitHub App's
# key"):
#
#   {{.InfrastructureKeySecret}}  the infrastructure GitHub App, whose
#     installation token 1-org's GitHub provider needs, with an organization
#     owner's rights over the applications' repositories. A run of the
#     triggers mints it from the key (cloud-build.tf) for a plan or an apply
#     of 1-org; a person applying 1-org by hand uses their own token.
#   {{.DeployerKeySecret}}  the deployer GitHub App, which the plan trigger's
#     run posts each layer's plan on the pull request as, and which every
#     application's pipeline talks back on its pull requests as: 2-env
#     carries the alias to the applications through its output, and grants
#     their identities the read.
#   {{.ReleaseKeySecret}}  the release GitHub App, which cuts every
#     application's releases: each application's release trigger, in tst's
#     Cloud Build as the application's release identity, mints the app's
#     token from the key and runs release-please. 2-env carries the alias
#     through its output and grants the release identities the read.
#
# This layer makes no secret. It grants on those three what its own
# identities and 1-org's need, with the policy administration the root
# organization gave this organization's boot identity (secretPolicyAdmin, a
# role of that project: a secret's IAM policy and nothing else), which is the
# only reach this organization has into that one: the org identity gets the
# deployer and release secrets' policy administration, which 1-org hands to
# each environment layer identity so 2-env can grant the applications'
# identities their read; 1-org's plan identity reads the infrastructure key,
# since a plan of 1-org reads the repositories; both boot plan identities read
# the three secrets' policies, which a plan of this layer or of 1-org
# refreshes the grants through. The runners' reads are cloud-build.tf's. No
# key reaches GitHub.
# ---------------------------------------------------------------------------

locals {
  keys_project = "{{.RootProject}}"
  key_secrets = {
    infrastructure = "{{.InfrastructureKeySecret}}"
    deployer       = "{{.DeployerKeySecret}}"
    release        = "{{.ReleaseKeySecret}}"
  }
  keys_policy_admin_role = "projects/{{.RootProject}}/roles/secretPolicyAdmin"
  boot_plan_key_reads = {
    for pair in setproduct(keys(local.boot_plans), keys(local.key_secrets)) :
    "${pair[0]}__${pair[1]}" => { plan = pair[0], key = pair[1] }
  }
}

resource "google_secret_manager_secret_iam_member" "org_tofu_keys" {
  for_each = toset(["deployer", "release"])

  project   = local.keys_project
  secret_id = local.key_secrets[each.key]
  role      = local.keys_policy_admin_role
  member    = google_service_account.org_tofu.member
}

# A plan of 1-org reads the applications' repositories with the infrastructure
# app's token, minted from the key: the org plan identity reads that one secret.
resource "google_secret_manager_secret_iam_member" "org_plan_infrastructure_key" {
  project   = local.keys_project
  secret_id = local.key_secrets.infrastructure
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.boot_plan["org"].member
}

# The viewer role reads a secret and its versions' metadata and its policy,
# never a payload.
resource "google_secret_manager_secret_iam_member" "boot_plan_keys" {
  for_each = local.boot_plan_key_reads

  project   = local.keys_project
  secret_id = local.key_secrets[each.value.key]
  role      = "roles/secretmanager.viewer"
  member    = google_service_account.boot_plan[each.value.plan].member
}

# The boot identity manages the token secret's policy (cloud-build.tf) when
# this layer runs through the apply trigger; the break-glass account's Owner
# covered the first apply.
resource "google_project_iam_member" "boot_tofu_secrets" {
  project = module.boot_project.project_id
  role    = "roles/secretmanager.admin"
  member  = google_service_account.boot_tofu.member
}
{{- end}}
