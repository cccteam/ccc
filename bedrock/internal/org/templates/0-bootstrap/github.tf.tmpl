# ---------------------------------------------------------------------------
# The GitHub Apps' keys
#
# Two of the organization's GitHub Apps act from the boot project, and their
# private keys live here, each a version of a container this layer creates,
# pinned by number in placement.json and never read as latest. The apps are a
# person's to create and the keys a person's to add (README, "The
# infrastructure GitHub App" and "The deployer GitHub App's key"):
#
#   {{.InfrastructureKeySecret}}  the infrastructure GitHub App, whose
#     installation token 1-org's GitHub provider needs, with an organization
#     owner's rights over the applications' repositories. A run of the
#     triggers mints it from the key (cloud-build.tf) for a plan or an apply
#     of 1-org; a person applying 1-org by hand uses their own token.
#   {{.DeployerKeySecret}}  the deployer GitHub App, which the plan trigger's
#     run posts each layer's plan on the pull request as, and which every
#     application's pipeline talks back on its pull requests as: 2-env
#     carries the pinned version to the applications through its output, and
#     grants their identities the read.
#
# The org identity administers both containers' policies (and reads the
# infrastructure key for 1-org's apply); 1-org's plan identity (bootstrap.tf)
# reads the infrastructure key too, since a plan of 1-org reads the
# repositories. 1-org grants each environment layer identity the deployer
# container's administration, so 2-env can grant the applications' identities
# their read. The runners' reads are cloud-build.tf's. The retired workload identity pool
# and provider of the layers workflow are gone from this layer; the triggers
# need no sign-in from GitHub.
# ---------------------------------------------------------------------------

resource "google_secret_manager_secret" "github_infrastructure_key" {
  project   = module.boot_project.project_id
  secret_id = "${var.prefix}-boot-gbl-github-infrastructure-key"

  replication {
    auto {}
  }

  labels = local.labels
}

resource "google_secret_manager_secret" "github_deployer_key" {
  project   = module.boot_project.project_id
  secret_id = "${var.prefix}-boot-gbl-github-deployer-key"

  replication {
    auto {}
  }

  labels = local.labels
}

resource "google_secret_manager_secret_iam_member" "org_tofu_infrastructure_key" {
  project   = module.boot_project.project_id
  secret_id = google_secret_manager_secret.github_infrastructure_key.secret_id
  role      = "roles/secretmanager.admin"
  member    = google_service_account.org_tofu.member
}

resource "google_secret_manager_secret_iam_member" "org_tofu_deployer_key" {
  project   = module.boot_project.project_id
  secret_id = google_secret_manager_secret.github_deployer_key.secret_id
  role      = "roles/secretmanager.admin"
  member    = google_service_account.org_tofu.member
}

# A plan of 1-org reads the applications' repositories with the infrastructure
# app's token, minted from the key: the org plan identity reads that one secret.
resource "google_secret_manager_secret_iam_member" "org_plan_infrastructure_key" {
  project   = module.boot_project.project_id
  secret_id = google_secret_manager_secret.github_infrastructure_key.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.boot_plan["org"].member
}

# The boot identity manages the containers when this layer runs through the
# apply trigger; the bootstrap administrator's Owner covered the first apply.
resource "google_project_iam_member" "boot_tofu_secrets" {
  project = module.boot_project.project_id
  role    = "roles/secretmanager.admin"
  member  = google_service_account.boot_tofu.member
}

# The pool and provider an earlier bedrock made for the layers workflow, and
# the bindings on the two identities, are retired: taken out of the state
# and destroyed, since nothing presents a GitHub token to them any more.
removed {
  from = google_iam_workload_identity_pool.github

  lifecycle {
    destroy = true
  }
}

removed {
  from = google_iam_workload_identity_pool_provider.github

  lifecycle {
    destroy = true
  }
}

removed {
  from = google_service_account_iam_member.boot_tofu_workflow

  lifecycle {
    destroy = true
  }
}

removed {
  from = google_service_account_iam_member.org_tofu_workflow

  lifecycle {
    destroy = true
  }
}
