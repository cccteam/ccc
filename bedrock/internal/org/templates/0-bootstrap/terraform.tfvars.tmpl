# Committed on purpose: nothing here is a secret. The REPLACEME values come
# from the seed step in README.md: the boot project ID the seed chose, suffix
# included, and the bare numeric IDs of the seeded organization and terraform
# folders.

billing_account_id = "{{.BillingAccount}}"
# boot_project_id is the ID the seed step chose, suffix included;
# organization_folder_id and terraform_folder_id are the bare numeric folder
# IDs from the seed step, under organization {{.OrganizationID}}.
boot_project_id        = "{{.BootProjectID}}"
organization_folder_id = "{{.OrganizationFolderID}}"
terraform_folder_id    = "{{.TerraformFolderID}}"

# The two roles/billing.user grants need Billing Account Administrator. A
# break-glass account that holds only Billing Account User leaves this
# false and a billing administrator makes the grants by hand (README.md,
# step 4); set it true once the identity applying this layer can manage
# billing IAM.
manage_billing_iam = false
