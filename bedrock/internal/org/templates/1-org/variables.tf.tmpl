variable "allowed_contact_domains" {
  description = "Domains permitted as Essential Contacts, enforced by the essentialcontacts.managed.allowedContactDomains constraint."
  type        = list(string)
  default     = {{.ContactDomainsList}}
}

variable "applications" {
  description = "The applications whose GitHub repositories this layer configures, one repository per application named after it. Rendered into applications.auto.tfvars by bedrock org register."
  type        = list(string)
  default     = []
}

variable "audit_log_retention_days" {
  description = "Retention period, in days, for the central audit log bucket in the log project. Only used when central_logging is true."
  type        = number
  default     = 400
}

variable "billing_account_id" {
  description = "(Required) Billing account ID to link projects to."
  type        = string
}

variable "boot_plan_roles" {
  description = "Organization-level roles granted to the plan identities of the two boot layers (0-bootstrap and 1-org, both in the boot project): the reads a plan of either layer needs, at the organization node since the layers declare folders, projects, tags and custom roles across it. A starting set, completed by refusal."
  type        = list(string)
  default = [
    "roles/browser",                         # the organization, its folders and projects
    "roles/essentialcontacts.viewer",        # Essential Contacts per folder
    "roles/iam.securityReviewer",            # every IAM policy the grants are refreshed through, and the custom roles
    "roles/iam.serviceAccountViewer",        # the identities in every project
    "roles/iam.workloadIdentityPoolViewer",  # the boot project's pool and provider
    "roles/orgpolicy.policyViewer",          # the folder-scoped constraints
    "roles/resourcemanager.tagViewer",       # the public-invoker tag
    "roles/secretmanager.viewer",            # the key container's metadata, never a version's payload
    "roles/serviceusage.serviceUsageViewer", # each project's enabled APIs
  ]
}

variable "boot_project_id" {
  description = "(Required) Boot project created by 0-bootstrap. Used as the quota and billing project for API calls."
  type        = string
}

variable "central_logging" {
  description = "Whether to create the log project, the central audit log bucket in it, and one audit log sink per folder. Off by default: nothing here needs a system of record beyond the audit logs every project already retains. Turning it on also needs roles/logging.configWriter and roles/storage.admin in org_layer_roles in 0-bootstrap; see the README."
  type        = bool
  default     = false
}

variable "essential_contact_emails" {
  description = "Email addresses registered as Essential Contacts on every folder. Must fall within allowed_contact_domains."
  type        = list(string)
  default     = []
}

variable "gcp_region" {
  description = "Primary GCP region for regional resources."
  type        = string
  default     = "{{.Primary.Name}}"
}

variable "gcp_secondary_region" {
  description = "Secondary GCP region, for resources that run in two regions. Nothing in this layer is regional; it is published as an output so every layer reads the same value."
  type        = string
  default     = "{{.Secondary.Name}}"
}

variable "github_default_branch" {
  description = "The default branch of every application repository, from which alone the operations workflow's Environments deploy."
  type        = string
  default     = "{{.GithubDefaultBranch}}"
}

variable "github_infrastructure_team" {
  description = "Slug of the organization's infrastructure team, whose approval a change to an application's workflow and Cloud Build files needs, given after the last push. Empty for none."
  type        = string
  default     = "{{.GithubInfrastructureTeam}}"
}

variable "github_organization" {
  description = "The GitHub organization that holds the application repositories."
  type        = string
  default     = "{{.GithubOrganization}}"
}

variable "github_release_app_id" {
  description = "App ID of the release GitHub App, the only actor that creates, moves or deletes a release tag; from the app's settings page (a private app cannot be read by its slug)."
  type        = number
  default     = {{.GithubReleaseAppID}}
}

variable "layer_roles" {
  description = <<-EOT
    Project-level roles granted to each layer identity on its own project.
    Keys map to the role_set field of each entry in var.projects.

    An entry is either a predefined role ("roles/...") or the bare ID of a
    custom organization role created in custom-roles.tf (currently only
    secretContainerAdmin). Custom roles are named by bare ID because a
    variable default cannot reference a resource; locals.tf resolves them.
  EOT
  type        = map(list(string))
  default = {
    app = [
      "roles/artifactregistry.admin",
      "roles/cloudbuild.builds.editor",
      "roles/cloudbuild.connectionAdmin",
      "roles/cloudscheduler.admin",
      "roles/cloudtasks.queueAdmin",
      "roles/iam.serviceAccountAdmin",
      "roles/iam.serviceAccountUser",
      "roles/iam.workloadIdentityPoolAdmin",
      # 2-env initializes Identity Platform on the environment project, the
      # Firebase Authentication the applications' live pages sign browsers in
      # through.
      "roles/identityplatform.admin",
      "roles/logging.admin",
      "roles/monitoring.admin",
      "roles/resourcemanager.projectIamAdmin",
      "roles/run.admin",
      "roles/serviceusage.serviceUsageAdmin",
      "roles/spanner.admin",
      "roles/storage.admin",
      "secretContainerAdmin",
    ]
    net = [
      "roles/certificatemanager.editor",
      "roles/compute.loadBalancerAdmin",
      "roles/compute.networkAdmin",
      "roles/compute.securityAdmin",
      "roles/dns.admin",
      "roles/iam.serviceAccountAdmin",
      "roles/iam.serviceAccountUser",
      "roles/logging.admin",
      "roles/monitoring.admin",
      "roles/resourcemanager.projectIamAdmin",
      "roles/serviceusage.serviceUsageAdmin",
      "roles/storage.admin",
    ]
    shr = [
      "roles/artifactregistry.admin",
      "roles/iam.serviceAccountAdmin",
      "roles/iam.serviceAccountUser",
      "roles/iam.workloadIdentityPoolAdmin",
      "roles/logging.admin",
      "roles/monitoring.admin",
      "roles/resourcemanager.projectIamAdmin",
      "roles/serviceusage.serviceUsageAdmin",
      "roles/storage.admin",
      "secretContainerAdmin",
    ]
    spn = [
      "roles/iam.serviceAccountAdmin",
      "roles/iam.serviceAccountUser",
      "roles/logging.admin",
      "roles/monitoring.admin",
      "roles/resourcemanager.projectIamAdmin",
      "roles/serviceusage.serviceUsageAdmin",
      "roles/spanner.admin",
      "roles/storage.admin",
    ]
  }
}

variable "org_policies" {
  description = <<-EOT
    Organization policy constraints applied to every folder this layer creates.
    Each entry names a constraint and one shape:

    enforce         boolean constraint; true enforces it
    deny_all        list constraint with no permitted values
    allowed_values  list constraint; the permitted values
    denied_values   list constraint; the forbidden values

    The default is the tf-gcp-setup baseline trimmed to constraints that cost
    nothing operationally in this organization; the README lists what was
    dropped and why. An organization trims or extends the list here without a
    code change. essentialcontacts.managed.allowedContactDomains is set
    separately, from var.allowed_contact_domains, because it takes parameters.
  EOT
  type = list(object({
    constraint     = string
    enforce        = optional(bool)
    deny_all       = optional(bool)
    allowed_values = optional(list(string))
    denied_values  = optional(list(string))
  }))
  default = [
    # Service account credentials. Keys are the one long-lived credential a
    # service account can have; nothing in this organization needs one, and
    # every runner authenticates as its service account directly.
    { constraint = "iam.managed.disableServiceAccountKeyCreation", enforce = true },
    { constraint = "iam.managed.disableServiceAccountKeyUpload", enforce = true },
    { constraint = "iam.serviceAccountKeyExpiryHours", allowed_values = ["2160h"] },
    { constraint = "iam.allowServiceAccountCredentialLifetimeExtension", deny_all = true },
    { constraint = "iam.automaticIamGrantsForDefaultServiceAccounts", enforce = true },
    { constraint = "iam.disableAuditLoggingExemption", enforce = true },

    # Cloud Storage. Every bucket is uniform-access, private, and reached over
    # TLS with an IAM identity rather than an HMAC key.
    { constraint = "storage.publicAccessPrevention", enforce = true },
    { constraint = "storage.secureHttpTransport", enforce = true },
    { constraint = "storage.uniformBucketLevelAccess", enforce = true },
    { constraint = "storage.restrictAuthTypes", denied_values = ["in:ALL_HMAC_SIGNED_REQUESTS"] },

    # Compute. No VMs are planned, so these cost nothing; they keep any VM that
    # does appear off the internet and off the serial console.
    { constraint = "compute.disableGlobalSerialPortAccess", enforce = true },
    { constraint = "compute.disableSerialPortAccess", enforce = true },
    { constraint = "compute.requireOsLogin", enforce = true },
    { constraint = "compute.requireShieldedVm", enforce = true },
    { constraint = "compute.skipDefaultNetworkCreation", enforce = true },
    { constraint = "compute.vmCanIpForward", deny_all = true },
    { constraint = "compute.vmExternalIpAccess", deny_all = true },

    # Ingress. Only the global external managed HTTP(S) load balancer, so every
    # request path runs through the same TLS and Cloud Armor configuration, and
    # Cloud Run is reachable only through it or from inside the VPC.
    { constraint = "compute.restrictLoadBalancerCreationForTypes", allowed_values = ["GLOBAL_EXTERNAL_MANAGED_HTTP_HTTPS"] },
    { constraint = "run.allowedIngress", allowed_values = ["internal-and-cloud-load-balancing"] },
    { constraint = "gcp.restrictTLSVersion", denied_values = ["TLS_VERSION_1", "TLS_VERSION_1_1"] },

    # Cloud Build. Builds run as an explicit service account (the legacy default
    # one is never created), and source connections are GitHub only.
    { constraint = "cloudbuild.disableCreateDefaultServiceAccount", enforce = true },
    { constraint = "cloudbuild.allowedIntegrations", allowed_values = ["github.com"] },
  ]

  validation {
    condition     = length(distinct([for p in var.org_policies : p.constraint])) == length(var.org_policies)
    error_message = "Each constraint may appear only once in org_policies."
  }

  validation {
    condition = alltrue([
      for p in var.org_policies :
      p.enforce != null || p.deny_all != null || p.allowed_values != null || p.denied_values != null
    ])
    error_message = "Every org_policies entry needs one of enforce, deny_all, allowed_values, or denied_values."
  }
}

variable "organization_domain" {
  description = "(Required) Domain name of the GCP Organization."
  type        = string
}

variable "plan_roles" {
  description = <<-EOT
    Project-level roles granted to each plan identity on its own project: the
    reads a plan of the project's layer needs, and no bundle. Keys map to the
    role_set field of each entry in var.projects, as var.layer_roles' do.

    Each set is the custom organization role of its kind from custom-roles.tf
    (named by bare ID; locals.tf resolves it), which reads the resource types
    the layer declares and nothing of their data, beside
    roles/iam.securityReviewer for the IAM policies the layer's grants are
    refreshed through. roles/viewer is in no set: it reads the rows of every
    Spanner database in the project, every container image, and the
    deployment records and uploaded files through the buckets' default grants
    to project viewers, none of which a plan reads.
  EOT
  type        = map(list(string))
  default = {
    app = [
      "environmentLayerPlanReader",
      "roles/iam.securityReviewer",
    ]
    net = [
      "networkLayerPlanReader",
      "roles/iam.securityReviewer",
      # The domain registrations. Cloud Domains permissions are not supported in
      # custom roles, so the registration's read comes from the cloud's viewer
      # bundle for the service: registrations, locations and operations, read only.
      "roles/domains.viewer",
    ]
    shr = [
      "servicesLayerPlanReader",
      "roles/iam.securityReviewer",
    ]
    spn = [
      "spannerLayerPlanReader",
      "roles/iam.securityReviewer",
    ]
  }
}

variable "prefix" {
  description = "Short org-wide prefix used in resource names (e.g. \"{{.Prefix}}\")."
  type        = string
  default     = "{{.Prefix}}"
}

variable "projects" {
  description = <<-EOT
    Every project in the organization, keyed by a short environment code. This
    is the provisioning process: adding a project means adding an entry here
    and re-running this layer.

    Each entry creates the project itself, and unless layer is false, a layer
    identity (the service account that applies the project's own layer, with
    the roles of its role set) and a read-only plan identity.

    folder      key in local.folders the project is created under
    description what the project is for
    api_set     key in var.required_apis selecting the APIs to enable
    role_set    key in var.layer_roles selecting the layer identity's roles
    layer       set false for projects managed entirely from this layer
  EOT
  type = map(object({
    folder      = string
    description = string
    api_set     = optional(string, "app")
    role_set    = optional(string, "app")
    layer       = optional(bool, true)
  }))
  default = {
    shr = {
      folder      = "shared"
      description = "Shared services: container images"
      api_set     = "shr"
      role_set    = "shr"
    }
    net = {
      folder      = "shared"
      description = "Shared network: global load balancer, DNS, certificates"
      api_set     = "net"
      role_set    = "net"
    }
    spn = {
      folder      = "shared"
      description = "Shared Spanner instance for stg and prd"
      api_set     = "spn"
      role_set    = "spn"
    }
    tst = {
      folder      = "tst"
      description = "Environment project: tst"
    }
    stg = {
      folder      = "stg"
      description = "Environment project: stg"
    }
    prd = {
      folder      = "prd"
      description = "Environment project: prd"
    }
  }

  validation {
    condition     = alltrue([for k, v in var.projects : can(regex("^[a-z][a-z0-9]{1,7}$", k))])
    error_message = "Project keys must be 2-8 lowercase alphanumeric characters; they are embedded in project IDs and service account IDs."
  }

  validation {
    condition     = !contains(keys(var.projects), "log")
    error_message = "The log project is added by central_logging, not by var.projects."
  }
}

variable "public_invokers" {
  description = "Per application, the IAM members of its apply identities in every environment (2-env's), granted roles/resourcemanager.tagUser on the public-invoker tag value (tags.tf): an apply identity binds the tag to its own Cloud Run services, which is what lets it grant allUsers roles/run.invoker there. Rendered into public-invokers.auto.tfvars by bedrock org register and committed after 2-env has created the identities, since a grant on an identity that does not exist is refused."
  type        = map(list(string))
  default     = {}
}

variable "state_bucket" {
  description = "The seeded state bucket every backend block names (placement.json, stateBucket). This layer reads 0-bootstrap's state from it and grants on it for the identities it creates (workflow.tf)."
  type        = string
  default     = "{{.StateBucket}}"
}

variable "required_apis" {
  description = "APIs enabled on each class of project. Keys map to the api_set field of each entry in var.projects."
  type        = map(list(string))
  default = {
    # The application layers name the environment project as their quota
    # project, so every API they call must be enabled here, the project and
    # storage ones included (the first 3-app apply, 2026-09-25, was refused:
    # "Cloud Resource Manager API has not been used in project ...").
    app = [
      # An application's stack makes the web API key its browsers present to
      # Firebase Authentication (apikeys), releases the security rules of its
      # Firestore database (firebaserules), and signs its browsers in with
      # custom tokens the Identity Toolkit API exchanges and the Secure Token
      # API refreshes; 2-env initializes Identity Platform on the project.
      "apikeys.googleapis.com",
      "artifactregistry.googleapis.com",
      "cloudbuild.googleapis.com",
      # The sign-in reads a login's role groups through the Cloud Identity
      # Groups API with the person's own token, and the API is consumed in the
      # project that owns the OAuth client: the environment project.
      "cloudidentity.googleapis.com",
      "cloudresourcemanager.googleapis.com",
      "cloudscheduler.googleapis.com",
      "cloudtasks.googleapis.com",
      "cloudtrace.googleapis.com",
      "compute.googleapis.com",
      # An application that declares a Firestore database (APP_FIRESTORE_DATABASE)
      # gets one beside its Spanner database, in the environment project.
      "firebaserules.googleapis.com",
      "firestore.googleapis.com",
      "iam.googleapis.com",
      "iamcredentials.googleapis.com",
      "identitytoolkit.googleapis.com",
      "logging.googleapis.com",
      "monitoring.googleapis.com",
      "run.googleapis.com",
      "secretmanager.googleapis.com",
      "securetoken.googleapis.com",
      "serviceusage.googleapis.com",
      "spanner.googleapis.com",
      "storage.googleapis.com",
      "sts.googleapis.com",
    ]
    log = [
      "iam.googleapis.com",
      "logging.googleapis.com",
      "monitoring.googleapis.com",
      "storage.googleapis.com",
    ]
    net = [
      "certificatemanager.googleapis.com",
      "compute.googleapis.com",
      "dns.googleapis.com",
      "domains.googleapis.com", # Cloud Domains: the registrations live beside their zones (2-net)
      "iam.googleapis.com",
      "logging.googleapis.com",
      "monitoring.googleapis.com",
    ]
    shr = [
      "artifactregistry.googleapis.com",
      "iam.googleapis.com",
      "iamcredentials.googleapis.com",
      "logging.googleapis.com",
      "monitoring.googleapis.com",
      "secretmanager.googleapis.com",
      "sts.googleapis.com",
    ]
    spn = [
      "iam.googleapis.com",
      "logging.googleapis.com",
      "monitoring.googleapis.com",
      "spanner.googleapis.com",
    ]
  }
}
