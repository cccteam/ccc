# Rendered by bedrock from placement.json (applications, projects) and owned by it: bedrock org
# render rewrites this file and bedrock org check compares it, so an application is registered
# in placement.json (bedrock org register <app>), never here. OpenTofu reads *.auto.tfvars after
# terraform.tfvars, which keeps the values a person decides.

# Each application's apply identity in the environments whose databases live on the
# shared instance (every one but the first, whose instance is its own), with the
# environment and application its grants are bounded to and, in every environment but
# production, the environment whose backups it may restore from. An application is listed
# once its registration is past its identities (placement.json's registration, moved by
# bedrock org register <app> --next after 2-env's apply has created them).
database_admins = {
{{- range $app := .Granted}}
{{- range $env := $.Environments}}
{{- if ne $env (index $.Environments 0)}}
  "{{$.ApplyIdentity $env $app}}" = { environment = "{{$env}}", application = "{{$app}}"{{if ne $env $.Production}}, restore_from = "{{$.Production}}"{{end}} } # {{$app}}'s {{$env}} apply identity (2-env {{$env}})
{{- end}}
{{- end}}
{{- end}}
}

# Each application's plan identity in the same environments: the organization's
# spannerPlanReader role on the instance, since a pull-request build plans the
# environment's stack as it and refreshes the database, its grants and its
# backup schedules here. Listed once the registration is past its identities, as the
# database admins.
database_planners = [
{{- range $app := .Granted}}
{{- range $env := $.Environments}}
{{- if ne $env (index $.Environments 0)}}
  "{{$.PlanIdentity $env $app}}", # {{$app}}'s {{$env}} plan identity (2-env {{$env}})
{{- end}}
{{- end}}
{{- end}}
]

# The first environment's deploy identity of each application, once per environment on this
# instance: a consolidation pull request's migration guard reads each environment's migration
# version through the migrations_reader database role, with the two bounded roles that use of a
# database role asks for. Listed once the registration is past its identities, as the database
# admins.
migration_readers = {
{{- range $app := .Granted}}
{{- range $env := $.Environments}}
{{- if ne $env (index $.Environments 0)}}
  "{{$env}}/{{$app}}" = { member = "{{$.DeployIdentity (index $.Environments 0) $app}}", environment = "{{$env}}", application = "{{$app}}" } # {{$app}}'s {{index $.Environments 0}} deploy identity (2-env {{index $.Environments 0}}) on its {{$env}} database
{{- end}}
{{- end}}
{{- end}}
}
