# Development environment for lodestar. Copy to .envrc and run `direnv allow`.
#
# Variables are grouped by configuration level (pkg/config). A process reads the levels
# it constructs and nothing above them: cmd/bootstrap and cmd/deployment/migrate read
# core and data; the served site reads all three.

# --- core: every process ---
export APP_SERVICE_NAME=lodestar
export APP_VERSION=dev
# GOOGLE_CLOUD_LOGGING_PROJECT ships request logs to Cloud Logging; unset logs to the console.
# export GOOGLE_CLOUD_LOGGING_PROJECT=

# --- data: every process that opens the database ---
export GOOGLE_CLOUD_SPANNER_PROJECT=lodestar-dev
export GOOGLE_CLOUD_SPANNER_INSTANCE_ID=lodestar
export GOOGLE_CLOUD_SPANNER_DATABASE_NAME=lodestar
# APP_DEFAULT_SESSION_TIMEOUT is the idle timeout of a browser session (default 10m).
# export APP_DEFAULT_SESSION_TIMEOUT=10m
# APP_COOKIE_KEY signs session cookies: Base64 of 32+ random bytes. Unset, the process
# generates an ephemeral key and sessions end when it restarts.
# export APP_COOKIE_KEY=
# The Firestore database the live service runs on (README, "Live pages" and "One channel
# between instances"): the subscription record, the per-user change sets, and the signals
# document the instances notify each other through. APP_FIRESTORE_DATABASE is the database
# id, the way the infrastructure hands a database to an application;
# GOOGLE_CLOUD_FIRESTORE_PROJECT is its project, required with the database (a process
# given the database without its project refuses to start, naming both variables, since
# the database is not assumed to be in the Spanner project); APP_FIREBASE_API_KEY is the
# Firebase web API key the browser initializes the SDK with in production. A database or
# the emulator below is required: every process that opens the database refuses to start
# naming both when neither is set. In development the emulator below stands in for all
# three, opened under the live driver's own project id (live-emulator).
# export GOOGLE_CLOUD_FIRESTORE_PROJECT=
# export APP_FIRESTORE_DATABASE=
# export APP_FIREBASE_API_KEY=

# --- site: the served site ---
export PORT=8090
# export APP_CONSOLE_DIST=web/dist/console
# export APP_PORTAL_DIST=web/dist/portal
# APP_DROIDS_API_KEY is the bearer key droids present on /droids. Unset, the process
# generates an ephemeral key nothing knows, which keeps the channel closed.
export APP_DROIDS_API_KEY=dev-droids-key
# APP_SCHEDULER_INVOKER is the invoker identity whose Google-signed tokens the scheduled
# routes (/_scheduled) admit, read by the framework (resource/scheduled), not pkg/config;
# on Cloud Run bedrock sets it to the scheduler's service account. Unset, as in
# development, the scheduled routes are off and refuse every call, and the start says so.
# export APP_SCHEDULER_INVOKER=
# APP_JOBS_TEMPLATE is the job process's template job as the Cloud Run API names it, read
# by the Cloud Run job driver (resource/jobs/cloudrun), whose settings the site level embeds
# (pkg/config/site.go); on Cloud Run bedrock sets it to the stack's template job, and the
# site starts the copy of its own build (the template's name with the version's key).
# Unset, as in development, no job is configured, and a scheduled method that starts one
# says so.
# export APP_JOBS_TEMPLATE=
# The file stores, one URL each: the default store (the refit photos') and the Documents
# store (the mission documents'), directories in development (gitignored); on Cloud Run
# bedrock sets each to its bucket, gs://<bucket>. cmd/bootstrap empties both directories
# before it seeds, and cmd/jobs cleanup-files removes what no row holds.
export APP_FILE_STORE=file://uploads
export APP_FILE_STORE_DOCUMENTS=file://uploads-documents

# --- local development only: the Spanner emulator the Procfile starts ---
# The bootstrap and the server pick their target from SPANNER_EMULATOR_HOST alone: unset it
# (and set GOOGLE_APPLICATION_CREDENTIALS) to run against a real, private instance; README,
# "Running against a real Spanner instance".
export SPANNER_EMULATOR_PORT=9014
export SPANNER_EMULATOR_HOST=127.0.0.1:${SPANNER_EMULATOR_PORT}
# The Firestore emulator the Procfile starts beside it, for the live pages. The server
# talks to it as the emulator's owner, and the token route hands the browser the same
# host, so the browser's change feed connects there too (the content security policy
# names it). Unset both to run against a real Firestore database (the data block above).
export FIRESTORE_EMULATOR_PORT=8084
export FIRESTORE_EMULATOR_HOST=127.0.0.1:${FIRESTORE_EMULATOR_PORT}
# overmind otherwise takes PORT as its base and hands every process its own (base, base+100,
# ...), so the server would listen on PORT+100 and the console proxy would miss it.
export OVERMIND_NO_PORT=1

# --- members auth: the directory its people sign in through (pkg/auth/members) ---
# The Procfile builds with the session library's skipAuth tag, which simulates the
# directory: every login through it is APP_USERNAME (APP_ROLES are the role claims), and
# only the redirect URL, the hosted domain, and the group prefix below is read. Register the application in a directory, fill the
# rest in, and drop the tag to use one.
export APP_USERNAME=client
export APP_ROLES=client-portal,client-account
# export APP_MEMBERS_OIDC_CLIENT_ID=
# export APP_MEMBERS_OIDC_CLIENT_SECRET=
# APP_MEMBERS_OIDC_REDIRECT_URL is the browser-facing callback of the surface that binds to
# the members auth, such as http://127.0.0.1:4300/console/api/user/callback through the dev proxy.
export APP_MEMBERS_OIDC_REDIRECT_URL=http://127.0.0.1:4301/portal/api/user/callback
# APP_MEMBERS_OIDC_HOSTED_DOMAIN is the Google Workspace domain logins are restricted to; the
# simulated directory presents it too, so it is set in development.
export APP_MEMBERS_OIDC_HOSTED_DOMAIN=example.com
# APP_MEMBERS_OIDC_GROUP_PREFIX names the Google Groups that carry roles: <prefix><role>@<domain>
# assigns <role>. Read under the simulated directory too (APP_ROLES stand in for the groups),
# so it is set in development.
export APP_MEMBERS_OIDC_GROUP_PREFIX=members-
# APP_MEMBERS_OIDC_GROUP_LOOKUP is how far the groups lookup reaches: direct (the default when
# unset) reads the groups the person is a direct member of; nested climbs from those to the
# groups they are in, level by level, for a directory that nests its role groups. The lookup
# runs with the person's own sign-in token. No effect under the simulated directory.
# export APP_MEMBERS_OIDC_GROUP_LOOKUP=direct
