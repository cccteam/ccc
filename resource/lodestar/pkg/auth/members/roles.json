{
  "roles": {
    "global": [
      {
        "name": "ClientAccount",
        "description": "A client's account: sees the client's own contacts.",
        "permissions": {
          "Read": [
            {
              "resource": "ClientContacts",
              "fields": [
                "displayName",
                "clientId"
              ],
              "condition": "userId = subject"
            }
          ],
          "List": [
            {
              "resource": "ClientContacts",
              "fields": [
                "displayName",
                "clientId"
              ],
              "condition": "userId = subject"
            }
          ]
        }
      }
    ],
    "domain": [
      {
        "name": "ClientPortal",
        "description": "A client in a sector: sees their missions, documents and statements, files a distress call, and stands down a mission.",
        "permissions": {
          "List": [
            {
              "resource": "MissionDocuments",
              "fields": [
                "missionId",
                "title",
                "fileName",
                "contentType",
                "size",
                "uploadedAt",
                "provenance"
              ],
              "condition": "client = subject.client"
            },
            {
              "resource": "Missions",
              "fields": [
                "title",
                "kindId",
                "statusId",
                "hazard",
                "fee",
                "deadline",
                "requiredCertId"
              ],
              "condition": "client = subject.client"
            },
            {
              "resource": "DistressCalls",
              "fields": [
                "summary",
                "severity",
                "caseNumber",
                "callerContact",
                "position"
              ],
              "condition": "filedBy = subject"
            },
            {
              "resource": "ClientStatements"
            }
          ],
          "Read": [
            {
              "resource": "MissionDocuments",
              "fields": [
                "missionId",
                "title",
                "fileName",
                "contentType",
                "size",
                "uploadedAt",
                "provenance"
              ],
              "condition": "client = subject.client"
            },
            {
              "resource": "Missions",
              "fields": [
                "title",
                "kindId",
                "statusId",
                "hazard",
                "fee",
                "deadline",
                "requiredCertId"
              ],
              "condition": "client = subject.client"
            },
            {
              "resource": "DistressCalls",
              "fields": [
                "summary",
                "severity",
                "caseNumber",
                "callerContact",
                "position"
              ],
              "condition": "filedBy = subject"
            }
          ],
          "Create": [
            {
              "resource": "DistressCalls",
              "fields": [
                "summary",
                "severity",
                "callerContact"
              ]
            }
          ],
          "Execute": [
            {
              "resource": "StandDownMission",
              "condition": "client = subject.client"
            }
          ]
        }
      }
    ]
  }
}
