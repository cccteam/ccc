# Development process file for overmind (https://github.com/DarthSim/overmind):
#
#     cp .envrc.template .envrc && direnv allow && overmind start
#
# spanner:  a fresh Spanner emulator (--rm, so every start bootstraps from scratch).
# server:   waits for the emulator, bootstraps the database (schema, roles, development
#           logins), then serves the application. Bootstrap and serve share one process
#           so the server never races the bootstrap.
# console:  waits for the server, then ng serve with /api proxied to it. Browse
#           http://127.0.0.1:4300.
#
# The browser processes need the web workspace installed once first (README, "Browser
# apps"); until then start the Go side alone: overmind start -l spanner,server
#
# .envrc sets OVERMIND_NO_PORT so PORT reaches each process as written; without it overmind
# reassigns PORT per process (base, base+100, ...) and the server binds the wrong port.
spanner: podman run --rm -p 127.0.0.1:${SPANNER_EMULATOR_PORT}:9010 gcr.io/cloud-spanner-emulator/emulator:1.5.56
server: bash -c 'for i in {1..300}; do (echo > /dev/tcp/127.0.0.1/${SPANNER_EMULATOR_PORT}) >/dev/null 2>&1 && break || sleep 0.1; done; go run -tags skipAuth ./cmd/bootstrap && go run -tags skipAuth .'
console: bash -c 'for i in {1..600}; do (echo > /dev/tcp/127.0.0.1/${PORT}) >/dev/null 2>&1 && break || sleep 0.5; done; cd web && bun run start:console'
portal: bash -c 'for i in {1..600}; do (echo > /dev/tcp/127.0.0.1/${PORT}) >/dev/null 2>&1 && break || sleep 0.5; done; cd web && bun run start:portal'
