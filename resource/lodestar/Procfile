# Development process file for overmind (https://github.com/DarthSim/overmind):
#
#     cp .envrc.template .envrc && direnv allow && overmind start
#
# spanner:  a fresh Spanner emulator (--rm, so every start bootstraps from scratch).
# firestore: a fresh Firestore emulator for the live service (the live pages' subscription
#           record and change sets, and the signals document the instances notify each other
#           through; README, "Live pages"), from the Cloud SDK emulators image the
#           resource package's tests pin, with the live package's security rules mounted.
#           Firestore needs no schema, so the bootstrap does nothing to it. The browser
#           reaches it at FIRESTORE_EMULATOR_HOST directly, as the token route says.
# server:   waits for both emulators (the Firestore emulator by its HTTP answer, since the
#           container's port accepts connections before the emulator inside serves them, and
#           the bootstrap's engines subscribe to the signals document as soon as they open),
#           bootstraps the database (schema, the demo world, development logins), then serves
#           the application. Bootstrap and serve share one process so the server never races
#           the bootstrap.
# console:  waits for the server, then ng serve with /console/api proxied to it. Browse
#           http://127.0.0.1:4300/console/.
# portal:   the same for the portal, with /portal/api proxied. Browse
#           http://127.0.0.1:4301/portal/.
#
# The browser processes need the web workspace installed once first (README, "Browser
# apps"); until then start the Go side alone: overmind start -l spanner,server
#
# .envrc sets OVERMIND_NO_PORT so PORT reaches each process as written; without it overmind
# reassigns PORT per process (base, base+100, ...) and the server binds the wrong port.
spanner: podman run --rm -p 127.0.0.1:${SPANNER_EMULATOR_PORT}:9010 gcr.io/cloud-spanner-emulator/emulator:1.5.56
firestore: bash -c 'rules=$(mktemp -d) && cp ../live/firestore/firestore.rules "$rules/" && exec podman run --rm -p 127.0.0.1:${FIRESTORE_EMULATOR_PORT}:8080 -v "$rules:/rules:ro,Z" gcr.io/google.com/cloudsdktool/google-cloud-cli:562.0.0-emulators gcloud emulators firestore start --host-port=0.0.0.0:8080 --rules=/rules/firestore.rules'
server: bash -c 'for i in {1..300}; do (echo > /dev/tcp/127.0.0.1/${SPANNER_EMULATOR_PORT}) >/dev/null 2>&1 && break || sleep 0.1; done; for i in {1..600}; do curl -sf -o /dev/null http://127.0.0.1:${FIRESTORE_EMULATOR_PORT}/ && break || sleep 0.1; done; go run -tags skipAuth ./cmd/bootstrap && go run -tags skipAuth .'
console: bash -c 'for i in {1..600}; do (echo > /dev/tcp/127.0.0.1/${PORT}) >/dev/null 2>&1 && break || sleep 0.5; done; cd web && bun run start:console'
portal: bash -c 'for i in {1..600}; do (echo > /dev/tcp/127.0.0.1/${PORT}) >/dev/null 2>&1 && break || sleep 0.5; done; cd web && bun run start:portal'
