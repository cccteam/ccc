# Development process file for overmind (https://github.com/DarthSim/overmind):
#
#     cp .envrc.template .envrc && direnv allow && overmind start
#
# spanner:   a fresh Spanner emulator (--rm, so every start bootstraps from scratch).
# firestore: a fresh Firestore emulator for the live pages: the subscriptions the server
#            registers and the change sets the browser listens to, under the rules in
#            schema/firestore. Firestore needs no schema, so nothing bootstraps it.
# server:    waits for both emulators, bootstraps the database (schema, roles, development
#            logins), then serves the application. Bootstrap and serve share one process
#            so the server never races the bootstrap.
# console:   waits for the server, then ng serve with /api proxied to it. Browse
#            http://127.0.0.1:4301.
#
# The browser processes need the web workspace installed once first (README, "Browser
# apps"); until then start the Go side alone: overmind start -l spanner,firestore,server
#
# .envrc sets OVERMIND_NO_PORT so PORT reaches each process as written; without it overmind
# reassigns PORT per process (base, base+100, ...) and the server binds the wrong port.
spanner: podman run --rm -p 127.0.0.1:${SPANNER_EMULATOR_PORT}:9010 gcr.io/cloud-spanner-emulator/emulator:1.5.56
firestore: podman run --rm -p 127.0.0.1:${FIRESTORE_EMULATOR_PORT}:8080 -v "${PWD}/schema/firestore:/rules:ro,Z" gcr.io/google.com/cloudsdktool/google-cloud-cli:562.0.0-emulators gcloud emulators firestore start --host-port=0.0.0.0:8080 --rules=/rules/firestore.rules
server: bash -c 'for i in {1..300}; do (echo > /dev/tcp/127.0.0.1/${SPANNER_EMULATOR_PORT}) >/dev/null 2>&1 && break || sleep 0.1; done; for i in {1..600}; do (echo > /dev/tcp/127.0.0.1/${FIRESTORE_EMULATOR_PORT}) >/dev/null 2>&1 && break || sleep 0.1; done; go run ./cmd/bootstrap && go run .'
console: bash -c 'for i in {1..600}; do (echo > /dev/tcp/127.0.0.1/${PORT}) >/dev/null 2>&1 && break || sleep 0.5; done; cd web && bun install && bun run start:console'
