{
  "roles": {
    "global": [
      {
        "name": "Administrator_Global",
        "permissions": {
          "Create": [
            {
              "resource": "StaffUsers",
              "fields": [
                "username",
                "password",
                "disabled",
                "email"
              ]
            },
            {
              "resource": "StaffInvitations",
              "fields": [
                "email",
                "roles"
              ]
            },
            {
              "resource": "StaffSeats",
              "fields": [
                "user",
                "role"
              ]
            }
          ],
          "Delete": [
            {
              "resource": "StaffUsers"
            },
            {
              "resource": "StaffInvitations"
            },
            {
              "resource": "StaffSeats"
            }
          ],
          "Execute": [
            {
              "resource": "SetStaffUserPassword"
            },
            {
              "resource": "ResetStaffUserFactors"
            }
          ],
          "List": [
            {
              "resource": "StaffUsers",
              "fields": [
                "username",
                "disabled",
                "hasPassword",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt",
                "organization",
                "identities",
                "roles",
                "everywhereRoles",
                "rolesSynced",
                "email",
                "emailVerifiedAt"
              ]
            },
            {
              "resource": "StaffInvitations",
              "fields": [
                "email",
                "roles",
                "invitedBy",
                "createdAt",
                "expiresAt"
              ]
            },
            {
              "resource": "StaffSeats",
              "fields": [
                "username",
                "everyDomain"
              ]
            },
            {
              "resource": "StaffRoles",
              "fields": [
                "kind"
              ]
            }
          ],
          "Read": [
            {
              "resource": "StaffUsers",
              "fields": [
                "username",
                "disabled",
                "hasPassword",
                "passwordChangeRequired",
                "createdAt",
                "lastSignInAt",
                "organization",
                "identities",
                "roles",
                "everywhereRoles",
                "rolesSynced",
                "email",
                "emailVerifiedAt"
              ]
            },
            {
              "resource": "StaffInvitations",
              "fields": [
                "email",
                "roles",
                "invitedBy",
                "createdAt",
                "expiresAt"
              ]
            },
            {
              "resource": "StaffSeats",
              "fields": [
                "username",
                "everyDomain"
              ]
            },
            {
              "resource": "StaffRoles",
              "fields": [
                "kind"
              ]
            }
          ],
          "Update": [
            {
              "resource": "StaffUsers",
              "fields": [
                "username",
                "disabled",
                "email"
              ]
            }
          ]
        }
      },
      {
        "name": "FeatureAdministrator",
        "permissions": {
          "Execute": [
            {
              "resource": "SetFeature"
            }
          ],
          "List": [
            {
              "resource": "FeatureFlags",
              "fields": [
                "description",
                "enabled",
                "updatedAt",
                "updatedBy"
              ]
            }
          ],
          "Read": [
            {
              "resource": "FeatureFlags",
              "fields": [
                "description",
                "enabled",
                "updatedAt",
                "updatedBy"
              ]
            }
          ]
        }
      }
    ],
    "domain": []
  }
}
