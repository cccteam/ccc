# Development environment for solo. Copy to .envrc and run `direnv allow`.
#
# Variables are grouped by configuration level (pkg/config). A process reads the levels
# it constructs and nothing above them: cmd/bootstrap and cmd/deployment/migrate read
# core and data; the served site reads all three.

# --- core: every process ---
export APP_SERVICE_NAME=solo
export APP_VERSION=dev
# GOOGLE_CLOUD_LOGGING_PROJECT ships request logs to Cloud Logging; unset logs to the console.
# export GOOGLE_CLOUD_LOGGING_PROJECT=

# --- data: every process that opens the database ---
export GOOGLE_CLOUD_SPANNER_PROJECT=solo-dev
export GOOGLE_CLOUD_SPANNER_INSTANCE_ID=solo
export GOOGLE_CLOUD_SPANNER_DATABASE_NAME=solo
# APP_DEFAULT_SESSION_TIMEOUT is the idle timeout of a browser session (default 10m).
# export APP_DEFAULT_SESSION_TIMEOUT=10m
# APP_COOKIE_KEY signs session cookies: Base64 of 32+ random bytes. Unset, the process
# generates an ephemeral key and sessions end when it restarts.
# export APP_COOKIE_KEY=
# The Firestore database the live pages run on, beside the Spanner database (pkg/config,
# FirestoreSettings): the subscriptions the server registers and the change sets the browser
# listens to. A deployment supplies APP_FIRESTORE_DATABASE (the database id) and
# APP_FIREBASE_API_KEY (the web API key the browser initializes the SDK with); in development
# the emulator below stands in and both stay unset. GOOGLE_CLOUD_FIRESTORE_PROJECT names the
# database's project when it is not the Spanner project. With none of these and no emulator,
# the application serves no live pages.
# export APP_FIRESTORE_DATABASE=
# export APP_FIREBASE_API_KEY=
# export GOOGLE_CLOUD_FIRESTORE_PROJECT=

# --- site: the served site ---
export PORT=8090
# export APP_CONSOLE_DIST=web/dist/console

# --- local development only: the emulators the Procfile starts ---
export SPANNER_EMULATOR_PORT=9014
export SPANNER_EMULATOR_HOST=127.0.0.1:${SPANNER_EMULATOR_PORT}
# The Firestore emulator serves the live pages in development: the server registers
# subscriptions and publishes changes there, and the token route hands the browser its host.
export FIRESTORE_EMULATOR_PORT=9024
export FIRESTORE_EMULATOR_HOST=127.0.0.1:${FIRESTORE_EMULATOR_PORT}
# overmind otherwise takes PORT as its base and hands every process its own (base, base+100,
# ...), so the server would listen on PORT+100 and the console proxy would miss it.
export OVERMIND_NO_PORT=1
