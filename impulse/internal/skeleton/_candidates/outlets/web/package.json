{
  "name": "outlets-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:console": "ng serve console --no-hmr",
    "start:portal": "ng serve portal --no-hmr",
    "build": "ng build console --define \"APP_VERSION='${VERSION:-dev}'\" && ng build portal --define \"APP_VERSION='${VERSION:-dev}'\"",
    "build:console": "ng build console --define \"APP_VERSION='${VERSION:-dev}'\"",
    "build:portal": "ng build portal --define \"APP_VERSION='${VERSION:-dev}'\"",
    "lint": "ng lint console && ng lint portal",
    "test": "ng test console --watch=false && ng test portal --watch=false",
    "ccclib:local": "./ccclib.sh local",
    "ccclib:push": "./ccclib.sh push",
    "ccclib:restore": "./ccclib.sh restore"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.1",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.1.1",
    "@angular/compiler": "^21.1.1",
    "@angular/core": "^21.1.1",
    "@angular/forms": "^21.1.1",
    "@angular/material": "^21.1.1",
    "@angular/platform-browser": "^21.1.1",
    "@angular/router": "^21.1.1",
    "@angular/service-worker": "^21.1.1",
    "@cccteam/resource": "0.0.5",
    "@cccteam/resource-angular": "0.0.5",
    "@cccteam/resource-firestore": "0.0.3",
    "@contentful/rich-text-types": "^17.2.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "overrides": {
    "@cccteam/resource": "0.0.5"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.1",
    "@types/node": "^25.0.10",
    "angular-eslint": "^21.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.1.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.8"
  }
