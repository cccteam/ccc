# The caches the pull request checks restore, filled after a push to the default branch
# (main or master) or a hotfix branch. Rendered by impulse and owned by it as
# .github/workflows/ci.yml is: impulse render rewrites both from the code, impulse check
# compares the committed files with what it renders, and the pins move with impulse
# releases, so dependabot must not run over this file either. Each job here does what the
# pull request job of the same id does, at the branch's head (the test legs run the tests,
# since what a test builds as it runs is in the cache only when it ran), and saves the Go
# module cache and build cache under that job's key with this commit's; a pull request run
# restores the newest entry of its lineage, so its first run starts from the branch it
# targets and compiles what it changed and nothing else. Nothing here gates anything: the
# branch was checked on its pull request, and a failure here is the squash commit's own.
name: CI cache

on:
  push:
    branches: [main, master, 'hotfix/**']

concurrency:
  group: ci-cache-${{ github.ref }}
  cancel-in-progress: true

permissions: {}

jobs:
  # The build, without tags and with skipAuth, as go-build builds it.
  go-build:
    runs-on: [[index .RunsOn "go-build"]]
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: false
[[- template "gocache-restore" (index .Cache "go-build")]]
      - name: go build
        run: |
          go build ./...
          go build -tags skipAuth ./...
      - name: go vet
        run: |
          go vet ./...
          go vet -tags skipAuth ./...
[[- template "gocache-save-always" (index .Cache "go-build")]]

  # The tests under the race detector, without tags, as go-test runs them[[if .TestCache]], and their results, which the pull request's go-test reuses (test-cache=on)[[end]].
  go-test:
    runs-on: [[index .RunsOn "go-test"]]
    timeout-minutes: 30
    permissions:
      contents: read
    env:
      # The test harnesses start the emulators through testcontainers. Its reaper container
      # (Ryuk) cleans up after a crashed test on a long-lived machine; a runner is discarded
      # after the job, and the reaper's own start has timed out on GitHub's runners.
      TESTCONTAINERS_RYUK_DISABLED: "true"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # The generators run bedrock migration renumber, which reads origin's copy of the default branch.
          fetch-depth: 0
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: false
[[- template "gocache-restore" (index .Cache "go-test")]]
[[- if .TestCache]]
[[- template "mtimes"]]
[[- end]]
      - name: go test
        run: go test -race [[.TestFlags]]-timeout 20m ./...
[[- template "gocache-save-always" (index .Cache "go-test")]]

  # The same with skipAuth, as go-test-skipauth runs them.
  go-test-skipauth:
    runs-on: [[index .RunsOn "go-test-skipauth"]]
    timeout-minutes: 30
    permissions:
      contents: read
    env:
      # The test harnesses start the emulators through testcontainers. Its reaper container
      # (Ryuk) cleans up after a crashed test on a long-lived machine; a runner is discarded
      # after the job, and the reaper's own start has timed out on GitHub's runners.
      TESTCONTAINERS_RYUK_DISABLED: "true"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # The generators run bedrock migration renumber, which reads origin's copy of the default branch.
          fetch-depth: 0
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: false
[[- template "gocache-restore" (index .Cache "go-test-skipauth")]]
[[- if .TestCache]]
[[- template "mtimes"]]
[[- end]]
      - name: go test (skipAuth)
        run: go test -race [[.TestFlags]]-timeout 20m -tags skipAuth ./...
[[- template "gocache-save-always" (index .Cache "go-test-skipauth")]]
